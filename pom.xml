<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.jawelte</groupId>
    <artifactId>jawelte-parent</artifactId>
    <version>0.1.0-SNAPSHOT</version>
    <packaging>pom</packaging>

    <name>jawelte (parent)</name>
    <description>Jakarta-based Java integration test framework. Top-level parent and aggregator.</description>
    <url>https://github.com/os890/jawelte</url>

    <licenses>
        <license>
            <name>Apache License, Version 2.0</name>
            <url>https://www.apache.org/licenses/LICENSE-2.0.txt</url>
            <distribution>repo</distribution>
        </license>
    </licenses>

    <scm>
        <connection>scm:git:https://github.com/os890/jawelte.git</connection>
        <developerConnection>scm:git:https://github.com/os890/jawelte.git</developerConnection>
        <url>https://github.com/os890/jawelte</url>
    </scm>

    <modules>
        <module>core</module>
        <module>modules</module>
        <module>tests</module>
        <module>coverage-report</module>
    </modules>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <!-- Dependency versions -->
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <microprofile.config.version>3.1</microprofile.config.version>
        <smallrye.config.version>3.10.0</smallrye.config.version>
        <mockito.version>5.14.2</mockito.version>
        <openwebbeans.version>4.1.0</openwebbeans.version>
        <weld.version>6.0.4.Final</weld.version>
        <junit.version>6.0.0</junit.version>
        <assertj.version>3.27.3</assertj.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>
        <jakarta.ejb.version>4.0.1</jakarta.ejb.version>
        <hibernate.orm.version>7.0.4.Final</hibernate.orm.version>
        <h2.version>2.3.232</h2.version>
        <asm.version>9.8</asm.version>
        <xbean.version>4.30</xbean.version>
        <opentest4j.version>1.3.0</opentest4j.version>
        <geronimo.transaction.version>4.0.0</geronimo.transaction.version>
        <narayana.jta.version>7.0.0.Final</narayana.jta.version>
        <jboss.transaction.spi.version>8.0.0.Final</jboss.transaction.spi.version>
        <atomikos.version>6.0.1</atomikos.version>
        <jackson.version>2.18.2</jackson.version>
        <dbunit.version>3.0.0</dbunit.version>
        <jakarta.el.version>6.0.1</jakarta.el.version>
        <expressly.version>6.0.0</expressly.version>
        <tomcat.el.version>11.0.7</tomcat.el.version>
        <jakarta.ws.rs.version>4.0.0</jakarta.ws.rs.version>
        <cxf.version>4.1.2</cxf.version>
        <resteasy.version>6.2.11.Final</resteasy.version>

        <!-- Plugin versions -->
        <maven.compiler.plugin.version>3.13.0</maven.compiler.plugin.version>
        <maven.surefire.plugin.version>3.5.2</maven.surefire.plugin.version>
        <maven.failsafe.plugin.version>3.5.2</maven.failsafe.plugin.version>
        <maven.jar.plugin.version>3.4.2</maven.jar.plugin.version>
        <maven.resources.plugin.version>3.3.1</maven.resources.plugin.version>
        <maven.install.plugin.version>3.1.3</maven.install.plugin.version>
        <maven.deploy.plugin.version>3.1.3</maven.deploy.plugin.version>
        <maven.enforcer.plugin.version>3.5.0</maven.enforcer.plugin.version>
        <maven.checkstyle.plugin.version>3.6.0</maven.checkstyle.plugin.version>
        <checkstyle.version>10.21.1</checkstyle.version>
        <apache.rat.plugin.version>0.16.1</apache.rat.plugin.version>
        <jacoco.plugin.version>0.8.13</jacoco.plugin.version>
        <maven.javadoc.plugin.version>3.11.2</maven.javadoc.plugin.version>

        <!-- Quality gate thresholds (project-wide; enforced in coverage-report module) -->
        <jacoco.line.coverage.minimum>0.80</jacoco.line.coverage.minimum>
        <jacoco.branch.coverage.minimum>0.70</jacoco.branch.coverage.minimum>
    </properties>

    <dependencyManagement>
        <dependencies>
            <!-- BOM import: pins every JUnit Jupiter / Platform artifact to ${junit.version}. -->
            <dependency>
                <groupId>org.junit</groupId>
                <artifactId>junit-bom</artifactId>
                <version>${junit.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>

            <!--
                Jakarta APIs are provided by the CDI runtime at test time;
                consumers of jawelte bring their own runtime, so we never
                ship these jars on a compile or runtime classpath. Children
                inherit this default and only override when they need a
                different scope (e.g. test sub-modules upgrade to test).
            -->
            <dependency>
                <groupId>jakarta.enterprise</groupId>
                <artifactId>jakarta.enterprise.cdi-api</artifactId>
                <version>${jakarta.cdi.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.annotation</groupId>
                <artifactId>jakarta.annotation-api</artifactId>
                <version>${jakarta.annotation.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.inject</groupId>
                <artifactId>jakarta.inject-api</artifactId>
                <version>${jakarta.inject.version}</version>
                <scope>provided</scope>
            </dependency>

            <!--
                JUnit defaults: junit-jupiter-api is `provided` because
                jawelte's user-facing classes implement JUnit callbacks
                but consumers bring their own JUnit version; the
                junit-jupiter umbrella + junit-platform-testkit are
                test-only.
            -->
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter-api</artifactId>
                <version>${junit.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.jupiter</groupId>
                <artifactId>junit-jupiter</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.junit.platform</groupId>
                <artifactId>junit-platform-testkit</artifactId>
                <version>${junit.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                MicroProfile Config: API on the production side is
                provided (consumers bring their own MP Config impl);
                SmallRye Config is the default test-scope implementation.
            -->
            <dependency>
                <groupId>org.eclipse.microprofile.config</groupId>
                <artifactId>microprofile-config-api</artifactId>
                <version>${microprofile.config.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>io.smallrye.config</groupId>
                <artifactId>smallrye-config</artifactId>
                <version>${smallrye.config.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- AssertJ is test-only across the project. -->
            <dependency>
                <groupId>org.assertj</groupId>
                <artifactId>assertj-core</artifactId>
                <version>${assertj.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                Mockito: provided. cdi-module's auto-mocking pulls it in;
                the project does not impose a Mockito version on
                consumers — every consumer pom that wants auto-mocking
                declares its own.
            -->
            <dependency>
                <groupId>org.mockito</groupId>
                <artifactId>mockito-core</artifactId>
                <version>${mockito.version}</version>
                <scope>provided</scope>
            </dependency>

            <!--
                CDI SE implementations. Both pinned in
                <dependencyManagement> with scope=test; the active impl
                is selected by Maven profile (-Powb default, -Pweld) on
                the consuming module.
            -->
            <dependency>
                <groupId>org.apache.openwebbeans</groupId>
                <artifactId>openwebbeans-se</artifactId>
                <version>${openwebbeans.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.weld.se</groupId>
                <artifactId>weld-se-shaded</artifactId>
                <version>${weld.version}</version>
                <scope>test</scope>
            </dependency>

            <!-- Internal cdi-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-cdi-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-cdi-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal scope-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-scope-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-scope-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal jpa-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jpa-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jpa-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal jta-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jta-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jta-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal ejb-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-ejb-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-ejb-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal content-diff-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-content-diff-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-content-diff-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal db-testdata-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-db-testdata-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-db-testdata-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal testcontrol-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-testcontrol-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-testcontrol-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!-- Internal jaxrs-module cross-references -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jaxrs-module-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-jaxrs-module-impl</artifactId>
                <version>${project.version}</version>
            </dependency>

            <!--
                Jackson supplies the JSON tree + parser-level line-number
                tracking that content-diff-module/impl's JsonDiffEngine
                consumes. compile scope — content-diff-module/impl ships
                Jackson transitively to its consumers, matching the
                project pattern that "compile-scope deps in
                modules/.../impl are part of the public surface".
            -->
            <dependency>
                <groupId>com.fasterxml.jackson.core</groupId>
                <artifactId>jackson-databind</artifactId>
                <version>${jackson.version}</version>
            </dependency>

            <!--
                DbUnit supplies the XML dataset parser, FK-aware
                DELETE/INSERT operations, and the cell-level diff
                primitives consumed by db-testdata-module/impl.
                compile scope — db-testdata-module/impl ships DbUnit
                transitively to its consumers, matching the project
                pattern that "compile-scope deps in modules/.../impl
                are part of the public surface".
            -->
            <dependency>
                <groupId>org.dbunit</groupId>
                <artifactId>dbunit</artifactId>
                <version>${dbunit.version}</version>
            </dependency>

            <!--
                Jakarta EL: api on the production side is provided —
                content-diff-module/impl's JakartaELInterpolator routes
                through ExpressionFactory.newInstance() and so works
                against any compliant provider. The project pins
                Apache Tomcat's tomcat-embed-el as the default
                test-scope provider; GlassFish Expressly is also pinned
                here, also at test scope, and consumers swap to it (or
                anywhere else) by replacing the dep in their own pom
                without a code change.
            -->
            <dependency>
                <groupId>jakarta.el</groupId>
                <artifactId>jakarta.el-api</artifactId>
                <version>${jakarta.el.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.tomcat.embed</groupId>
                <artifactId>tomcat-embed-el</artifactId>
                <version>${tomcat.el.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.glassfish.expressly</groupId>
                <artifactId>expressly</artifactId>
                <version>${expressly.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                JTA implementations. test-scope by default: jta-module's
                three Maven profiles (-P jta-geronimo, -P jta-narayana,
                -P jta-atomikos) add exactly one of these to the active
                test classpath so each provider's isAvailable() / create()
                / userTransaction() path can be exercised in isolation.
                Production consumers ship their own JTA jar at the scope
                of their choice.
            -->
            <dependency>
                <groupId>org.apache.geronimo.components</groupId>
                <artifactId>geronimo-transaction</artifactId>
                <version>${geronimo.transaction.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.narayana.jta</groupId>
                <artifactId>narayana-jta</artifactId>
                <version>${narayana.jta.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.narayana.jta</groupId>
                <artifactId>jta</artifactId>
                <version>${narayana.jta.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss</groupId>
                <artifactId>jboss-transaction-spi</artifactId>
                <version>${jboss.transaction.spi.version}</version>
                <scope>test</scope>
            </dependency>
            <!--
                Atomikos transactions-jta ships the
                jakarta.transaction.* namespace under the `jakarta`
                Maven classifier; the default-classifier jar is still
                javax-namespaced and incompatible with this project's
                Jakarta stack. depMgmt pins the jakarta-classified
                jar so any consumer that declares
                `com.atomikos:transactions-jta` with
                `<classifier>jakarta</classifier>` picks up the right
                jar without restating the version. Picked up by
                AtomikosTransactionManagerProvider when on the
                classpath. The jta-atomikos test profile in
                tests/jta-module activates this dep for the dedicated
                Atomikos scenarios.
            -->
            <dependency>
                <groupId>com.atomikos</groupId>
                <artifactId>transactions-jta</artifactId>
                <version>${atomikos.version}</version>
                <classifier>jakarta</classifier>
                <scope>test</scope>
                <optional>true</optional>
            </dependency>
            <!--
                Atomikos's pooled DataSource bridge
                (AtomikosDataSourceBean). Required when
                AtomikosTransactionManagerProvider is the active TM
                provider because the project's default
                XaDataSourceWrapper cannot satisfy Atomikos's strict
                resource-recovery model against H2 (whose
                XAResource.isSameRM is identity-only). Same
                jakarta-classifier story as transactions-jta.
            -->
            <dependency>
                <groupId>com.atomikos</groupId>
                <artifactId>transactions-jdbc</artifactId>
                <version>${atomikos.version}</version>
                <classifier>jakarta</classifier>
                <scope>test</scope>
                <optional>true</optional>
            </dependency>

            <!--
                JPA / Transaction APIs default to provided: the CDI runtime
                (or a Jakarta EE container) supplies them at test time, the
                same way as the core jakarta.* APIs above.
            -->
            <dependency>
                <groupId>jakarta.persistence</groupId>
                <artifactId>jakarta.persistence-api</artifactId>
                <version>${jakarta.persistence.version}</version>
                <scope>provided</scope>
            </dependency>
            <dependency>
                <groupId>jakarta.transaction</groupId>
                <artifactId>jakarta.transaction-api</artifactId>
                <version>${jakarta.transaction.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--
                jakarta.ejb-api defaults to provided for the same reason
                as the JPA / Transaction APIs above. ejb-module/api is
                annotation-free at compile time; only ejb-module/impl
                (and its tests) reference jakarta.ejb.Singleton /
                @Stateless and the other session-bean annotation
                classes.
            -->
            <dependency>
                <groupId>jakarta.ejb</groupId>
                <artifactId>jakarta.ejb-api</artifactId>
                <version>${jakarta.ejb.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--
                jakarta.ws.rs-api defaults to provided for the same
                reason: a JAX-RS provider (CXF / RESTEasy, selected
                via Maven profile in tests/jaxrs-module/*) brings its
                own copy of the API at test time. jaxrs-module/api
                references jakarta.ws.rs.core.Response for the
                ResponseDiff adapter signature.
            -->
            <dependency>
                <groupId>jakarta.ws.rs</groupId>
                <artifactId>jakarta.ws.rs-api</artifactId>
                <version>${jakarta.ws.rs.version}</version>
                <scope>provided</scope>
            </dependency>

            <!--
                ASM is provided so consumers can bring their own version
                without conflicting with ours. jpa-module/impl uses it
                for bytecode-level @Entity scanning (avoids Class.forName).
            -->
            <dependency>
                <groupId>org.ow2.asm</groupId>
                <artifactId>asm</artifactId>
                <version>${asm.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--
                xbean-finder hosts the @Entity discovery pass: jpa-module's
                EntityScanner walks the classpath via xbean's AnnotationFinder
                + ClasspathArchive instead of a hand-rolled ASM crawler.
                Provided scope — every JPA-driven consumer brings its own
                finder version transitively, so we don't pin one for them.
            -->
            <dependency>
                <groupId>org.apache.xbean</groupId>
                <artifactId>xbean-finder-shaded</artifactId>
                <version>${xbean.version}</version>
                <scope>provided</scope>
            </dependency>
            <!--
                xbean-naming — JNDI provider used by jta-module's
                JndiArtifactBinder to bind the active provider's
                TransactionManager / UserTransaction /
                TransactionSynchronizationRegistry under standard
                JNDI names. Narayana's CDI integration (and any
                vendor that follows the same convention) then resolves
                them through JNDI regardless of which TM is actually
                active. Test scope — production deployments ship their
                own JNDI (real Jakarta-EE container) or pull this
                themselves.
            -->
            <dependency>
                <groupId>org.apache.xbean</groupId>
                <artifactId>xbean-naming</artifactId>
                <version>${xbean.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                Hibernate ORM and H2 are test-only across the project:
                jpa-module's per-scenario smoke tests bring them up.
                Consumers pick their own JPA provider and JDBC driver in
                production deployments.
            -->
            <dependency>
                <groupId>org.hibernate.orm</groupId>
                <artifactId>hibernate-core</artifactId>
                <version>${hibernate.orm.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>com.h2database</groupId>
                <artifactId>h2</artifactId>
                <version>${h2.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                JAX-RS SeBootstrap implementations. test-scope by default:
                jaxrs-module's two Maven profiles (-Pcxf default,
                -Presteasy switch) add exactly one of these stacks to
                the active test classpath so each provider's
                RuntimeDelegate / SeBootstrap.Instance path can be
                exercised in isolation, mirroring the -Powb / -Pweld
                selection for the CDI SE runtime. Production consumers
                ship their own JAX-RS provider.
            -->
            <dependency>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-rt-frontend-jaxrs</artifactId>
                <version>${cxf.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-rt-transports-http-jetty</artifactId>
                <version>${cxf.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.apache.cxf</groupId>
                <artifactId>cxf-rt-rs-client</artifactId>
                <version>${cxf.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.resteasy</groupId>
                <artifactId>resteasy-core</artifactId>
                <version>${resteasy.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.resteasy</groupId>
                <artifactId>resteasy-undertow</artifactId>
                <version>${resteasy.version}</version>
                <scope>test</scope>
            </dependency>
            <dependency>
                <groupId>org.jboss.resteasy</groupId>
                <artifactId>resteasy-client</artifactId>
                <version>${resteasy.version}</version>
                <scope>test</scope>
            </dependency>

            <!--
                opentest4j ships TestAbortedException — used by
                jpa-module/impl to skip subsequent test methods in
                @PersistenceConfig(fileMode=true). provided scope
                matches its usual delivery via junit-jupiter-api in
                test classpaths.
            -->
            <dependency>
                <groupId>org.opentest4j</groupId>
                <artifactId>opentest4j</artifactId>
                <version>${opentest4j.version}</version>
                <scope>provided</scope>
            </dependency>

            <!--
                Internal cross-module references default to compile.
                Test sub-modules override to test scope at the leaf pom.
            -->
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-core-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>${project.groupId}</groupId>
                <artifactId>jawelte-core-impl</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <version>${maven.compiler.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <showWarnings>true</showWarnings>
                        <showDeprecation>true</showDeprecation>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-surefire-plugin</artifactId>
                    <version>${maven.surefire.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-failsafe-plugin</artifactId>
                    <version>${maven.failsafe.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-jar-plugin</artifactId>
                    <version>${maven.jar.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-resources-plugin</artifactId>
                    <version>${maven.resources.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-install-plugin</artifactId>
                    <version>${maven.install.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-deploy-plugin</artifactId>
                    <version>${maven.deploy.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-enforcer-plugin</artifactId>
                    <version>${maven.enforcer.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-checkstyle-plugin</artifactId>
                    <version>${maven.checkstyle.plugin.version}</version>
                    <dependencies>
                        <dependency>
                            <groupId>com.puppycrawl.tools</groupId>
                            <artifactId>checkstyle</artifactId>
                            <version>${checkstyle.version}</version>
                        </dependency>
                    </dependencies>
                    <configuration>
                        <configLocation>${maven.multiModuleProjectDirectory}/checkstyle.xml</configLocation>
                        <consoleOutput>true</consoleOutput>
                        <failsOnError>true</failsOnError>
                        <linkXRef>false</linkXRef>
                        <includeTestSourceDirectory>true</includeTestSourceDirectory>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.apache.rat</groupId>
                    <artifactId>apache-rat-plugin</artifactId>
                    <version>${apache.rat.plugin.version}</version>
                    <configuration>
                        <excludes>
                            <exclude>**/target/**</exclude>
                            <exclude>**/.git/**</exclude>
                            <exclude>**/.idea/**</exclude>
                            <exclude>**/.mvn/**</exclude>
                            <exclude>mvnw</exclude>
                            <exclude>mvnw.cmd</exclude>
                            <exclude>.gitignore</exclude>
                            <exclude>**/*.md</exclude>
                            <exclude>logo/**</exclude>
                            <exclude>docs/**</exclude>
                            <exclude>errors/**</exclude>
                            <exclude>tickets/**</exclude>
                        </excludes>
                    </configuration>
                </plugin>

                <plugin>
                    <groupId>org.jacoco</groupId>
                    <artifactId>jacoco-maven-plugin</artifactId>
                    <version>${jacoco.plugin.version}</version>
                </plugin>

                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-javadoc-plugin</artifactId>
                    <version>${maven.javadoc.plugin.version}</version>
                    <configuration>
                        <release>${maven.compiler.release}</release>
                        <failOnWarnings>true</failOnWarnings>
                        <doclint>all</doclint>
                        <quiet>true</quiet>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>

        <plugins>
            <!-- Cross-cutting gates that run on every module by inheritance. -->

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-enforcer-plugin</artifactId>
                <executions>
                    <execution>
                        <id>enforce-rules</id>
                        <goals>
                            <goal>enforce</goal>
                        </goals>
                        <configuration>
                            <rules>
                                <requireJavaVersion>
                                    <version>[25,)</version>
                                </requireJavaVersion>
                                <requireMavenVersion>
                                    <version>[3.9,)</version>
                                </requireMavenVersion>
                                <dependencyConvergence/>
                                <bannedDependencies>
                                    <excludes>
                                        <exclude>javax.*:*</exclude>
                                    </excludes>
                                </bannedDependencies>
                            </rules>
                        </configuration>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.rat</groupId>
                <artifactId>apache-rat-plugin</artifactId>
                <executions>
                    <execution>
                        <id>rat-check</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-checkstyle-plugin</artifactId>
                <executions>
                    <execution>
                        <id>checkstyle-validate</id>
                        <phase>validate</phase>
                        <goals>
                            <goal>check</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>

            <plugin>
                <groupId>org.jacoco</groupId>
                <artifactId>jacoco-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>jacoco-prepare-agent</id>
                        <goals>
                            <goal>prepare-agent</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>jacoco-report</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>report</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
