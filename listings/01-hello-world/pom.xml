<!--
    Stand-alone Maven project for jawelte documentation listing 01:
    hello-world.

    NO <parent>. Copy this folder anywhere on your machine, run
    `mvn test` from inside it, and the listing builds and runs against
    your local Maven repository's jawelte 0.1.0-SNAPSHOT artefacts.
    Run `mvn -DskipTests install` once from the jawelte repository
    root if those snapshots are not yet installed (see
    ../README.md).
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.jawelte.listings</groupId>
    <artifactId>jawelte-listing-01-hello-world</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>jawelte listing 01: hello-world</name>
    <description>The minimum viable jawelte test: @EnableTestBeans on a JUnit test class, @Inject on a real @ApplicationScoped CDI bean, one assertion.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <jawelte.version>0.1.0-SNAPSHOT</jawelte.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <microprofile.config.version>3.1</microprofile.config.version>
        <smallrye.config.version>3.10.0</smallrye.config.version>
        <openwebbeans.version>4.1.0</openwebbeans.version>
        <junit.version>6.0.0</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencies>
        <!-- jawelte API: @EnableTestBeans on the test class. -->
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <version>${jawelte.version}</version>
        </dependency>
        <!-- jawelte core impl: JUnit-side delegating extension, discovered via ServiceLoader. -->
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <!-- jawelte cdi-module: TestBeanContainerPort impl that boots the CDI container around the test class. -->
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- CDI API: @ApplicationScoped on the bean, @Inject on the test field. -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>${jakarta.inject.version}</version>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
        </dependency>

        <!-- MicroProfile Config: jawelte's bootstrap configuration channel. SmallRye is the runtime impl. -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${microprofile.config.version}</version>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
            <version>${smallrye.config.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- OpenWebBeans: the CDI runtime used by this listing. Swap for org.jboss.weld.se:weld-se-shaded to run under Weld instead. -->
        <dependency>
            <groupId>org.apache.openwebbeans</groupId>
            <artifactId>openwebbeans-se</artifactId>
            <version>${openwebbeans.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- JUnit 5 + AssertJ for the test itself. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
