<!--
    Stand-alone Maven project for jawelte documentation listing testcontrol-module/02:
    testcontrol-module update-phase. @TestControl(testData = "...")
    seeds CSV-style XML rows from dbIn/ before the test method runs.

    NO <parent>. Copy this folder anywhere on your machine, run
    `mvn test` from inside it, and the listing builds and runs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.jawelte.listings</groupId>
    <artifactId>jawelte-listing-testcontrol-module-02-update-phase</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>jawelte listing testcontrol-module/02: update-phase</name>
    <description>testcontrol-module update-phase: @TestControl(testData) seeds rows from dbIn/*.xml before the test method runs.</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <jawelte.version>0.1.0-SNAPSHOT</jawelte.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.inject.version>2.0.1</jakarta.inject.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.persistence.version>3.2.0</jakarta.persistence.version>
        <jakarta.transaction.version>2.0.1</jakarta.transaction.version>
        <microprofile.config.version>3.1</microprofile.config.version>
        <smallrye.config.version>3.10.0</smallrye.config.version>
        <openwebbeans.version>4.1.0</openwebbeans.version>
        <weld.version>6.0.4.Final</weld.version>
        <hibernate.orm.version>7.0.4.Final</hibernate.orm.version>
        <h2.version>2.3.232</h2.version>
        <xbean.version>4.30</xbean.version>
        <asm.version>9.8</asm.version>
        <junit.version>6.0.0</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-jpa-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-db-testdata-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
            <exclusions>
                <!--
                    dbunit 3.0.0 pulls in junit-platform-suite-engine:1.10.1,
                    which transitively brings junit-platform-launcher:1.10.1
                    onto the classpath. That clashes with the junit-jupiter
                    6.0.0 stack (junit-platform-engine:6.0.0) and the runner
                    fails discovery with "OutputDirectoryCreator not
                    available". jawelte does not need the suite engine for
                    its own DbDiff/DbSeed usage; excluding it keeps the
                    JUnit 6 versions aligned.
                -->
                <exclusion>
                    <groupId>org.junit.platform</groupId>
                    <artifactId>junit-platform-suite-engine</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-testcontrol-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-testcontrol-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <version>${jakarta.inject.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
            <version>${jakarta.persistence.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <version>${jakarta.transaction.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${microprofile.config.version}</version>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
            <version>${smallrye.config.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <version>${hibernate.orm.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
            <version>${h2.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-finder-shaded</artifactId>
            <version>${xbean.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
            <version>${asm.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>owb</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                    <version>${openwebbeans.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>weld</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                    <version>${weld.version}</version>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
