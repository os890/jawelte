<!--
    Same three rows as the dbIn dataset, but listed in a different order
    (3, 1, 2 instead of 1, 2, 3). The default diff is order-sensitive
    at the row level; .unorderedTables("ORDER_ROW") tells the engine to
    compare ORDER_ROW as a multiset and the row reorder stops mattering.
-->
<dataset>
    <ORDER_ROW ID="3" PRODUCT="cherry" LAST_MODIFIED="2026-05-21T10:00:02Z"/>
    <ORDER_ROW ID="1" PRODUCT="apple"  LAST_MODIFIED="2026-05-21T10:00:00Z"/>
    <ORDER_ROW ID="2" PRODUCT="banana" LAST_MODIFIED="2026-05-21T10:00:01Z"/>
</dataset>
