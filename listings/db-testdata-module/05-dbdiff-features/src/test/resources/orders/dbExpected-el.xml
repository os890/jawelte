<!--
    Expected dataset using both a bean-property dereference and a
    custom static function for EL interpolation. NOTE: the EL
    interpolator operates on the raw dataset text, so it sees text
    inside XML comments too — avoid writing literal placeholder
    examples (like the function-call syntax shown below in the
    actual ORDER_ROW elements) inside comments, or escape them.
-->
<dataset>
    <ORDER_ROW ID="1" PRODUCT="${catalog.appleName}"  LAST_MODIFIED="2026-05-21T10:00:00Z"/>
    <ORDER_ROW ID="2" PRODUCT="${catalog.bananaName}" LAST_MODIFIED="2026-05-21T10:00:01Z"/>
    <ORDER_ROW ID="3" PRODUCT="${fn:lower('CHERRY')}" LAST_MODIFIED="2026-05-21T10:00:02Z"/>
</dataset>
