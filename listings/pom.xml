<!--
    Thin aggregator for the documentation listings. Lets us run every
    listing in one sweep with `mvn -f listings/pom.xml test`.

    Deliberately stand-alone: no <parent>, no <dependencyManagement>,
    no shared <dependencies>. The child listings under this folder
    are independent Maven projects that do NOT declare this pom as
    their parent — readers are meant to be able to copy any single
    listing out of the repository and run `mvn test` on it without
    dragging anything else along.

    This aggregator is also NOT wired into the jawelte root reactor:
    the root pom's <modules> section does not list "listings", so
    `mvn verify` from the repo root and the verify-all.sh sweep do
    not touch the listings folder. Refreshing the snapshots the
    listings depend on is a separate one-time step documented in
    listings/README.md.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.jawelte.listings</groupId>
    <artifactId>jawelte-listings</artifactId>
    <version>0.1.0</version>
    <packaging>pom</packaging>

    <name>jawelte (documentation listings)</name>
    <description>Aggregator for the runnable code listings that back jawelte's HTML documentation. Each child module is a stand-alone Maven project; this pom is for batch-running them locally only.</description>

    <!--
        Listings are grouped by module under listings/<module>/. Each
        sub-folder has its own aggregator pom that lists its child
        listings; this top-level aggregator lists those module
        aggregators. Adding a new sample for an existing module is
        an append inside the module folder + an entry in that
        module's aggregator — no global renumbering, no shifting of
        unrelated listings.
    -->
    <modules>
        <module>core</module>
        <module>scope-module</module>
        <module>jpa-module</module>
        <module>jta-module</module>
        <module>ejb-module</module>
        <module>jaxrs-module</module>
        <module>testcontrol-module</module>
        <module>db-testdata-module</module>
        <module>content-diff-module</module>
        <module>wiremock-module</module>
        <module>spring-data-module</module>
        <module>batch-module</module>
    </modules>
</project>
