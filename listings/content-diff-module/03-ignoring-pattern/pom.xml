<!--
    Stand-alone Maven project for jawelte documentation listing content-diff-module/03:
    content-diff-module ignoring pattern. Pass a JSON-path to
    ignoring(...) so a volatile field (timestamp, generated id, etc.)
    is skipped during the diff.

    content-diff-module is a utility library — no CDI bootstrap needed,
    no owb/weld profile split.

    NO <parent>. Copy this folder anywhere on your machine, run
    `mvn test` from inside it, and the listing builds and runs.
-->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <groupId>org.os890.jawelte.listings</groupId>
    <artifactId>jawelte-listing-content-diff-module-03-ignoring-pattern</artifactId>
    <version>0.1.0</version>
    <packaging>jar</packaging>

    <name>jawelte listing content-diff-module/03: ignoring-pattern</name>
    <description>content-diff-module ignoring pattern: skip a noisy field (e.g. a timestamp) by passing its JSON-path to ignoring(...).</description>

    <properties>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <maven.compiler.release>25</maven.compiler.release>

        <jawelte.version>0.1.0-SNAPSHOT</jawelte.version>
        <jakarta.cdi.version>4.1.0</jakarta.cdi.version>
        <jakarta.annotation.version>3.0.0</jakarta.annotation.version>
        <jakarta.el.version>6.0.1</jakarta.el.version>
        <microprofile.config.version>3.1</microprofile.config.version>
        <smallrye.config.version>3.10.0</smallrye.config.version>
        <jackson.version>2.20.1</jackson.version>
        <tomcat.el.version>11.0.7</tomcat.el.version>
        <junit.version>6.0.0</junit.version>
        <assertj.version>3.27.3</assertj.version>
    </properties>

    <dependencies>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-content-diff-module-api</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.os890.jawelte</groupId>
            <artifactId>jawelte-content-diff-module-impl</artifactId>
            <version>${jawelte.version}</version>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <version>${microprofile.config.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
            <version>${smallrye.config.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            Jakarta EL: api + Tomcat's tomcat-embed-el as the default
            EL provider. Swap for `org.glassfish.expressly:expressly`
            if you prefer Expressly — the interpolator is
            provider-agnostic.
        -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
            <version>${jakarta.el.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>org.apache.tomcat.embed</groupId>
            <artifactId>tomcat-embed-el</artifactId>
            <version>${tomcat.el.version}</version>
            <scope>test</scope>
        </dependency>

        <!-- jackson-databind is the default JSON engine -->
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
            <version>${jackson.version}</version>
            <scope>test</scope>
        </dependency>

        <!--
            jakarta.enterprise.cdi-api is read by TestContext.loadService's
            tryCdiFirst path even when no CDI container is bootstrapped.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <version>${jakarta.cdi.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <version>${jakarta.annotation.version}</version>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <version>${assertj.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
