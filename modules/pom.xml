<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-modules</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (modules aggregator)</name>
    <description>Top-level aggregator for jawelte feature modules. Each feature module is a Maven aggregator with api / impl submodules.</description>

    <!--
        The module list lives in two profiles rather than in the POM
        body, so a build can leave out what depends on an artefact that
        is not released yet:

          mvn install                        every module (all-modules)
          mvn install -P minimal-modules     only released dependencies

        `all-modules` is activeByDefault. That is safe here because
        `activeByDefault` is only switched off by another profile
        declared in THE SAME POM, and this POM declares nothing but
        these two: the CDI-runtime and JTA-implementation profiles
        (`owb`, `weld`, `jta-geronimo`, `jta-narayana`, `cxf`,
        `resteasy`, `lnp`) all live in tests/<module>/pom.xml and in the
        scenario POMs, so `-P weld` never touches this list. The two
        axes are orthogonal and combine freely:
        `-P weld,minimal-modules`.

        Anything named here that is missing from `minimal-modules` must
        say why in the comment next to it.
    -->
    <profiles>
        <profile>
            <id>all-modules</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>cdi-module</module>
                <module>scope-module</module>
                <module>jpa-module</module>
                <module>jta-module</module>
                <module>ejb-module</module>
                <module>content-diff-module</module>
                <module>db-testdata-module</module>
                <module>testcontrol-module</module>
                <module>jaxrs-module</module>
                <module>wiremock-module</module>
                <module>batch-module</module>
                <module>spring-data-module</module>
                <!--
                    Depends on org.os890.cdi.uml:dynamic-cdi-flow-renderer,
                    which has no release yet:
                    https://github.com/os890/dynamic-cdi-flow-renderer
                    Left out of `minimal-modules` until it has one.
                -->
                <module>flow-assert-module</module>
            </modules>
        </profile>
        <profile>
            <id>minimal-modules</id>
            <modules>
                <module>cdi-module</module>
                <module>scope-module</module>
                <module>jpa-module</module>
                <module>jta-module</module>
                <module>ejb-module</module>
                <module>content-diff-module</module>
                <module>db-testdata-module</module>
                <module>testcontrol-module</module>
                <module>jaxrs-module</module>
                <module>wiremock-module</module>
                <module>batch-module</module>
                <module>spring-data-module</module>
            </modules>
        </profile>
    </profiles>
</project>
