<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-batch-module</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-batch-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (batch-module/api)</name>
    <description>Ships exactly one public type — BatchExecution, the CDI event class that carries both the request (jobName, parameters, timeout) and the result (executionId, JobExecution, BatchStatus, exitStatus). The api jar references jakarta.batch-api types (JobExecution, BatchStatus) on the BatchExecution accessor signature, mirroring jpa-module/api's use of jakarta.persistence-api and jaxrs-module/api's use of jakarta.ws.rs-api. No SPI ports, no qualifier types, no interfaces.</description>

    <dependencies>
        <!--
            core-api supplies references appearing in javadoc only
            (TestContext lifetime parallels for JobOperator's
            container-scoped caching). No runtime dep on
            TestModuleLifecyclePort: the batch module ships no
            lifecycle adapter.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jakarta.batch-api supplies JobExecution and BatchStatus —
            both appear on BatchExecution's accessor signatures
            (getJobExecution(), getStatus()). provided scope; consumers
            bring their own jBatch runtime at test time, which in turn
            brings the spec API.
        -->
        <dependency>
            <groupId>jakarta.batch</groupId>
            <artifactId>jakarta.batch-api</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api is reserved for future api
            additions (e.g. @Priority on a future spi surface).
            provided scope (inherited).
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
