<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-db-testdata-module</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-db-testdata-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (db-testdata-module/api)</name>
    <description>DbSeed and DbDiff fluent entry points + DbSeedBuilder / DbDiffBuilder + DbDifference / SeedSpec / DiffSpec records + the DbSeedEngine / DbDiffEngine / ELInterpolator SPI ports. No DbUnit / Hibernate / Jakarta-EL implementation imports — the api jar loads cleanly even when no engine or interpolator is on the classpath. Compile-deps on jpa-module/api so that forPersistenceUnit(...) can reference the PersistenceUnitConnectionResolver port owned by TICKET-005.</description>

    <dependencies>
        <!--
            core-api supplies TestContext.loadService(...) +
            ServicePriorityResolver + ConfigResolver. The api caches
            per-format engine / interpolator resolutions through
            ServicePriorityResolver and reads boolean / ignore / unordered
            MP Config defaults through ConfigResolver.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jpa-module/api supplies PersistenceUnitConnectionResolver,
            the port referenced by forPersistenceUnit(...). No code-link
            to jpa-module/impl — the default resolver impl is loaded via
            ServiceLoader at runtime.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>

        <!--
            jakarta.cdi-api is referenced at compile time by
            DbSeed.forPersistenceUnit() / DbDiff.forPersistenceUnit()
            for the CDI.current() lookup of the synthetic TestContext
            bean. scope=provided (inherited from the parent pom's
            dependencyManagement): consumers bring their own CDI
            implementation jar (OWB, Weld, Quarkus, ...) on the test
            classpath.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
