<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-db-testdata-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-db-testdata-module-impl-arc</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (db-testdata-module/impl)</name>
    <description>ArC-native db-testdata bundle. Hosts the built-in DbUnit XML engines (DbUnitXmlSeedEngine, DbUnitXmlDiffEngine), the JakartaELInterpolator default, and the DbTestDataArcContextContributor that captures @PersistenceConfig.persistenceUnitName from the active test class into the per-test static slot the default PersistenceUnitNameSupplier reads.</description>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus BOM scoped to db-testdata-module/impl (same
                 isolation strategy as cdi / scope / jpa). -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
        <!-- db-testdata-module/impl ships an ArcContextContributor that
             plugs into cdi-module/impl's SPI; the dep transitively
             pulls in quarkus-arc-processor / quarkus-arc. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl-arc</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api supplies the @Priority annotation
            stamped on the built-in engines / interpolator. provided
            scope at the depMgmt level; engines are loaded via
            ServiceLoader and their @Priority is read reflectively
            by the ServicePriorityResolver.
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!--
            DbUnit drives the DbUnitXmlSeedEngine /
            DbUnitXmlDiffEngine. compile scope — part of the public
            surface of db-testdata-module/impl.
        -->
        <dependency>
            <groupId>org.dbunit</groupId>
            <artifactId>dbunit</artifactId>
        </dependency>

        <!--
            Jakarta EL drives the JakartaELInterpolator. provided —
            the concrete provider (tomcat-embed-el or expressly) is
            chosen by the consuming pom.
        -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
        </dependency>

        <!--
            jakarta.cdi-api supports the
            AnnotationDrivenPersistenceUnitExtension and the default
            @ApplicationScoped PersistenceUnitNameSupplier bean. The
            extension captures @PersistenceConfig.persistenceUnitName
            from the active test class during BeforeBeanDiscovery (when
            TestContext.get() still resolves); the supplier bean pulls
            the captured value from the extension via
            BeanManager.getExtension(...) in its
            @Initialized(ApplicationScoped.class) observer. provided
            scope (inherited from the parent pom): the CDI
            implementation jar is brought by the consuming test module.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
            jpa-module/api is reachable transitively via
            db-testdata-module/api, but the CDI Extension directly
            references @PersistenceConfig; declared here so this
            module's compile classpath records the dependency
            explicitly.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
