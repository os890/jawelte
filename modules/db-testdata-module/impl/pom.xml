<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-db-testdata-module</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-db-testdata-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (db-testdata-module/impl)</name>
    <description>Built-in DbUnit XML engines (DbUnitXmlSeedEngine, DbUnitXmlDiffEngine) and the JakartaELInterpolator default. The seed engine maps SeedMode -&gt; DatabaseOperation; the diff engine emits a typed List&lt;DbDifference&gt; per cell mismatch / missing row / extra row, with 1-based expected-line numbers from a custom SAX pass over the expected XML. ELInterpolator runs Jakarta EL with values + beans + functions; missing variables / methods surface as RuntimeException at evaluation time, never at registration.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api supplies the @Priority annotation
            stamped on the built-in engines / interpolator. provided
            scope at the depMgmt level; engines are loaded via
            ServiceLoader and their @Priority is read reflectively
            by the ServicePriorityResolver.
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!--
            DbUnit drives the DbUnitXmlSeedEngine /
            DbUnitXmlDiffEngine. compile scope — part of the public
            surface of db-testdata-module/impl.
        -->
        <dependency>
            <groupId>org.dbunit</groupId>
            <artifactId>dbunit</artifactId>
        </dependency>

        <!--
            Jakarta EL drives the JakartaELInterpolator. provided —
            the concrete provider (tomcat-embed-el or expressly) is
            chosen by the consuming pom.
        -->
        <dependency>
            <groupId>jakarta.el</groupId>
            <artifactId>jakarta.el-api</artifactId>
        </dependency>

        <!--
            jakarta.cdi-api supports the
            AnnotationDrivenPersistenceUnitExtension and the default
            @ApplicationScoped PersistenceUnitNameSupplier bean. The
            extension captures @PersistenceConfig.persistenceUnitName
            from the active test class during BeforeBeanDiscovery (when
            TestContext.get() still resolves); the supplier bean pulls
            the captured value from the extension via
            BeanManager.getExtension(...) in its
            @Initialized(ApplicationScoped.class) observer. provided
            scope (inherited from the parent pom): the CDI
            implementation jar is brought by the consuming test module.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
            jpa-module/api is reachable transitively via
            db-testdata-module/api, but the CDI Extension directly
            references @PersistenceConfig; declared here so this
            module's compile classpath records the dependency
            explicitly.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
