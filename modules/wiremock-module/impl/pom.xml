<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-wiremock-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-wiremock-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (wiremock-module/impl)</name>
    <description>Implementation of wiremock-module: WireMockLifecycleAdapter (TestModuleLifecyclePort at @Priority(75) — same band as jaxrs-module, between testcontrol at 50 and scope at 100); a CDI producer (the api↔library bridge — the ONLY place upstream org.wiremock library types are imported, satisfying @Inject WireMock / @Inject WireMockServer); a CDI extension for @WireMockEndpoint discovery + synthetic-bean registration in AfterBeanDiscovery; the per-class WireMockServerRegistry bean carrying an impl-internal marker annotation; and an AnnotationScopeRemap SPI provider (SL-registered on scope-module/api's SPI) that remaps the registry's marker to @TestClassScoped at ProcessAnnotatedType time, driven by scope-module's ScopeRemapCdiExtension. SPI lookups for core go through TestContext.loadService(...) — no compile-time dep on core/impl.</description>

    <dependencies>
        <!--
            wiremock-module/api supplies @EnableWireMock (read off
            the active test class by WireMockLifecycleAdapter) and
            @WireMockEndpoint (the meta-qualifier scanned by the
            CDI extension during endpoint discovery).
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-wiremock-module-api</artifactId>
        </dependency>

        <!--
            core-api supplies the TestModuleLifecyclePort + TestContext
            infrastructure that WireMockLifecycleAdapter implements
            and reads through TestContext.loadService(...) at boot
            time. SPI-only — no compile-time dep on core/impl.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            scope-module/api supplies the @TestClassScoped scope
            (the remap target) and the AnnotationScopeRemap SPI (the
            mechanism the registry-marker remap provider implements).
            Hard compile dep — the impl ships an SL provider for
            scope-module's SPI; scope-module is always on the
            classpath of any wiremock-module/impl consumer.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
        </dependency>

        <!--
            org.wiremock:wiremock supplies WireMockServer (booted in
            beforeAll, stopped in afterAll) and the
            com.github.tomakehurst.wiremock.client.WireMock stub
            registration client (produced by the impl's CDI
            producer). Compile scope — this jar IS the api↔library
            bridge; consumers add wiremock-module-impl to their test
            classpath and WireMock comes along transitively.
        -->
        <dependency>
            <groupId>org.wiremock</groupId>
            <artifactId>wiremock</artifactId>
        </dependency>

        <!--
            jakarta.enterprise.cdi-api supplies the CDI Extension
            SPI (ProcessAnnotatedType, AfterBeanDiscovery,
            BeanManager) and the @Default / @Produces / @Dependent
            annotations used by the producer and synthetic-bean
            machinery. provided scope.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api supplies @Priority used by
            WireMockLifecycleAdapter. provided scope.
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!--
            microprofile-config-api is reserved for any future MP
            Config keys wiremock-module/impl might consume. Currently
            zero impl-side keys (endpoint port + HTTPS settings live
            on the @WireMockEndpoint meta-qualifier), kept as a
            near-zero-cost provided dep for forward-compatibility.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
