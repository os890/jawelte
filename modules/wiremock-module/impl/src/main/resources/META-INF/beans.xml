<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
    <!--
        wiremock-module/impl's CDI bean surface:

          - WireMockServerRegistry (@ApplicationScoped, with the
            impl-internal @WireMockManagedScope marker — scope-module's
            ScopeRemapCdiExtension remaps the marker to
            @TestClassScoped at ProcessAnnotatedType time).
          - WireMockProducer (@ApplicationScoped, vetoed by
            WireMockCdiExtension when at least one
            @WireMockEndpoint qualifier is discovered).

        WireMockLifecycleAdapter is NOT a CDI bean — it is
        ServiceLoader-loaded via TestModuleLifecyclePort.
        WireMockCdiExtension is also not a CDI bean in the user
        sense — it is loaded via the CDI runtime's own
        ServiceLoader-driven Extension SPI.

        The synthetic per-qualifier beans (one WireMockServer +
        one WireMock per discovered @WireMockEndpoint qualifier)
        are registered programmatically by
        WireMockCdiExtension.onAfterBeanDiscovery and don't appear
        in this beans.xml.
    -->
</beans>
