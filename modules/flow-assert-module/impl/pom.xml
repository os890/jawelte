<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-flow-assert-module</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-flow-assert-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (flow-assert-module/impl)</name>
    <description>Bridges the cdi-flow recorder into the jawelte lifecycle: FlowRecordingConfigSource translates @EnableFlowAssert into the cdi-flow.* keys the recorder reads while the container boots, CapturingFlowSink collects every flow of the running test method, and FlowAssertLifecycleAdapter (@Priority(Integer.MAX_VALUE) - last in beforeEach, first in afterEach) scopes the recording to the test method and evaluates @ExpectedFlow. Ships MermaidFlowDialect / PlantUmlFlowDialect and the alignment-based FlowDiffEngine.</description>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-flow-assert-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api supplies the @Priority annotation
            stamped on the lifecycle adapter, the two dialects and the
            diff engine - all three loaded via ServiceLoader and sorted
            by the ServicePriorityResolver.
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!--
            The recorder itself. compile scope: this is the
            api-to-library bridge (same convention as
            wiremock-module/impl), so a consumer adding
            jawelte-flow-assert-module-impl to its test classpath gets
            the recorder - and with it the portable extension that
            attaches the recording interceptor - at the scope it
            declared the impl jar at.
        -->
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
            <scope>compile</scope>
        </dependency>

        <!--
            microprofile-config-api supplies the ConfigSource SPI
            FlowRecordingConfigSource implements. provided at the
            depMgmt level - core/impl brings an implementation.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            The recorder's test-jar carries CallNodeBuilder, which
            builds a CallFlow without a container - the unit-tests of
            the two dialects and of the diff engine compare rendered
            diagrams, and building the flows by hand is what keeps them
            container-free.
        -->
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
            <type>test-jar</type>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
