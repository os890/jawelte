# The two built-in notations, both at @Priority(Integer.MAX_VALUE) so a
# custom dialect claiming the same file extension outranks them. The
# extension of the expected file is what selects one of them.

org.os890.jawelte.module.flowassert.impl.adapter.dialect.MermaidFlowDialect
org.os890.jawelte.module.flowassert.impl.adapter.dialect.PlantUmlFlowDialect
