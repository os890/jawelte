<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-flow-assert-module</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-flow-assert-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (flow-assert-module/api)</name>
    <description>@EnableFlowAssert / @ExpectedFlow annotations, the fluent FlowDiff entry point with its DiffSpec / Difference records, RecordedFlows, the canonical FlowStep model and the three ports: FlowDialect (one per notation, keyed by file extension), FlowDiffEngine (the comparison itself) and FlowRecordingPort (what the running test method recorded). Routes every lookup through core/api's TestContext.loadService(...) so the project-wide priority sort applies.</description>

    <dependencies>
        <!--
            core-api supplies TestContext.loadService(...) +
            ServicePriorityResolver + ConfigResolver. FlowDiff resolves
            its dialect / engine / recording port through them and reads
            its MP Config defaults through ConfigResolver.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            The cdi-flow recorder supplies CallFlow / CallNode, which
            appear on FlowDialect.render(...) and on
            FlowRecordingPort.recordedFlows() - the recorded flow IS the
            subject of this module, so unlike content-diff-module/api
            this api jar does reference the library it integrates.
            provided: a consumer brings the recorder itself, exactly as
            it brings a jBatch runtime for batch-module.
        -->
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
