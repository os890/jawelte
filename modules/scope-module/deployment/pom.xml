<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-scope-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-scope-module-deployment</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (scope-module/deployment)</name>
    <description>Quarkus extension deployment artifact for scope-module. Hosts the @BuildStep that returns a ContextRegistrarBuildItem registering @TestClassScoped and @TestMethodScoped with ArC's build pipeline so the scopes work under @QuarkusTest.</description>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <!-- The runtime artifact this extension manages. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-impl-arc</artifactId>
        </dependency>
        <!-- Quarkus's ArC build-time API: ContextRegistrarBuildItem +
             @BuildStep + friends. -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc-processor</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <!--
                        Quarkus's extension-processor scans @BuildStep
                        classes at compile time and emits the
                        META-INF/quarkus-build-steps.list metadata
                        Quarkus's bootstrap loads from the deployment
                        artifact. Without this annotation processor on
                        the path, the build step is invisible to
                        Quarkus at app boot.
                    -->
                    <annotationProcessorPaths>
                        <path>
                            <groupId>io.quarkus</groupId>
                            <artifactId>quarkus-extension-processor</artifactId>
                            <version>${quarkus.version}</version>
                        </path>
                    </annotationProcessorPaths>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
