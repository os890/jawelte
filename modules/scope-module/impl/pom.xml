<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-scope-module</artifactId>
        <version>0.1.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-scope-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (scope-module/impl)</name>
    <description>Implementation of jawelte's test-lifecycle CDI scopes. Hosts the per-method / per-class CDI Context implementations, the bean stores bound on TestContext, the TestScopeCdiExtension that registers the contexts, the BeanScopeMapper SPI providers (e.g. ConfigBeanToTestClassScoped) that core/impl's ScopeRemapCdiExtension consumes to remap stereotyped beans at ProcessAnnotatedType time (e.g. @ConfigBean from @ApplicationScoped to @TestClassScoped, preserving an explicit direct scope), and the ScopeLifecycleAdapter (TestModuleLifecyclePort impl) that drives activation / deactivation.</description>

    <dependencies>
        <!--
            Compile deps. All scopes inherited from jawelte-parent's
            <dependencyManagement>. scope-module/impl explicitly does
            NOT compile-depend on cdi-module — cross-module wiring goes
            through the TestBeanDefaultScope / AutoMockDefaultScope
            records on TestContext.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
