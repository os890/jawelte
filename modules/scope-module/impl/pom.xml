<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-scope-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-scope-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (scope-module/impl)</name>
    <description>Implementation of jawelte's test-lifecycle CDI scopes under Quarkus ArC. Hosts the per-method / per-class InjectableContext implementations, the bean stores bound on TestContext, an ArcContextContributor that registers both contexts through ArC's ContextRegistrar SPI at BeanProcessor build time, and the ScopeLifecycleAdapter (TestModuleLifecyclePort impl) that drives activation / deactivation.</description>

    <dependencyManagement>
        <dependencies>
            <!--
                Quarkus BOM scoped to scope-module/impl. Pinned here
                (rather than at the root pom) because the BOM also
                forces smallrye-config / jackson / commons-io / etc.
                versions; propagating those to unrelated modules would
                break their existing deps. cdi-module/impl uses the
                same isolation strategy.
            -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
        <!--
            scope-module/impl now compile-depends on cdi-module/impl
            for the ArcContextContributor SPI it implements. The dep
            also transitively pulls in quarkus-arc-processor so this
            module can reference ContextRegistrar / ContextConfigurator
            and quarkus-arc so the InjectableContext interface is
            available.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
