<beans xmlns="https://jakarta.ee/xml/ns/jakartaee"
       xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
       xsi:schemaLocation="https://jakarta.ee/xml/ns/jakartaee
                           https://jakarta.ee/xml/ns/jakartaee/beans_4_0.xsd"
       version="4.0"
       bean-discovery-mode="annotated">
    <!--
        jta-module/impl ships no CDI beans of its own. The JTA
        TransactionStrategy and the JtaPersistencePropertyResolver are
        loaded via Java ServiceLoader; the StandaloneJtaPlatform is
        instantiated by Hibernate via the
        hibernate.transaction.jta.platform property; the default
        TransactionManagerProvider impls are also ServiceLoader-loaded.
        beans-xml is shipped only so the bean-discovery scan picks the
        annotated mode (rather than tripping over implicit-archive
        behaviour) when this jar lands on the test classpath.
    -->
</beans>
