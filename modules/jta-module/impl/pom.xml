<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jta-module</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jta-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jta-module/impl)</name>
    <description>Implementation of jawelte's JTA integration. Hosts JtaTransactionStrategy (the @Priority-winning TransactionStrategy impl), the GeronimoPersistencePropertyResolver (active PersistencePropertyResolver), the default TransactionManagerProvider impls (Geronimo, Narayana, Atomikos), the Hibernate StandaloneJtaPlatform, and the XaDataSourceWrapper. Each provider impl uses Class.forName-based isAvailable() to keep no compile-time dep on the JTA jars themselves.</description>

    <dependencies>
        <!--
            Compile deps. jta-module/impl compiles against jpa-module/api
            for the TransactionStrategy and PersistencePropertyResolver
            ports, and against jta-module/api for TransactionManagerProvider.
            No compile-time dep on jpa-module/impl — the JTA strategy
            implements only the TransactionStrategy SPI and lets Hibernate
            handle EM ↔ JTA-tx enlistment via the configured JtaPlatform.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jta-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>

        <!--
            Hibernate ORM at provided scope: StandaloneJtaPlatform
            extends Hibernate's AbstractJtaPlatform so the EMF property
            hibernate.transaction.jta.platform can resolve to it.
            Consumers running against a different JPA provider would
            need to ship their own JtaPlatform impl.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            Test scope: a white-box unit test for JtaTransactionStrategy's
            EVENTS_BOUND marker lifecycle. Stubs the TransactionManager /
            Transaction directly (no CDI container, no real TM) to drive a
            reused Transaction object across completion — versions are
            managed by the root pom's dependencyManagement.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jndi-module supplies the JndiContextProvider port and, at
            runtime, the adapter that installs the naming provider. The
            impl is a runtime dependency rather than a compile one: this
            module codes against the port only, but a naming tree has to
            exist for the vendor lookups of TransactionManager / UserTransaction to resolve.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jndi-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jndi-module-impl</artifactId>
            <scope>runtime</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
