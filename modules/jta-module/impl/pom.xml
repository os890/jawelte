<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jta-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jta-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jta-module/impl)</name>
    <description>ArC-native implementation of jawelte's JTA integration. Hosts JtaArcContextContributor (registers the synthetic Narayana JTAEnvironmentBean and applies vendor-veto ExcludeTypes through ArC's BeanRegistrar / Builder), JtaTransactionStrategy, the default TransactionManagerProvider impls (Geronimo, Narayana, Atomikos), the Hibernate StandaloneJtaPlatform, and the XaDataSourceWrapper.</description>

    <dependencyManagement>
        <dependencies>
            <!-- Quarkus BOM scoped to jta-module/impl (same isolation
                 strategy as cdi / scope / jpa / db-testdata). -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jta-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
        <!-- jta-module/impl ships an ArcContextContributor that plugs
             into cdi-module/impl's SPI; transitively pulls in
             quarkus-arc-processor / quarkus-arc. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>

        <!--
            Hibernate ORM at provided scope: StandaloneJtaPlatform
            extends Hibernate's AbstractJtaPlatform so the EMF property
            hibernate.transaction.jta.platform can resolve to it.
            Consumers running against a different JPA provider would
            need to ship their own JtaPlatform impl.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
