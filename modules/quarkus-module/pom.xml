<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-modules</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-quarkus-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (quarkus-module aggregator)</name>
    <description>Quarkus-flavour TestBeanContainerPort adapter. Replaces cdi-module under @QuarkusTest: Quarkus owns the CDI container lifecycle; this module supplies only the build-time and runtime glue for jawelte's @EnableTestBeans / @TestBean / auto-mock surface. Ships as a Quarkus extension — a runtime artifact (jawelte-quarkus-module-runtime) plus a deployment artifact (jawelte-quarkus-module-deployment).</description>

    <modules>
        <module>runtime</module>
        <module>deployment</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!--
                Quarkus BOM scoped to the quarkus-module subtree only.
                Imported here (not in the root pom) because the BOM
                overrides smallrye-config / jackson / commons-io / etc.
                versions; letting those overrides propagate to non-
                Quarkus modules breaks bean discovery in OWB / Weld
                (concretely surfaced as scenario-04 ambiguity in
                wiremock-module).
            -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>
</project>
