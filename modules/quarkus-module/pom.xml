<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-modules</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-quarkus-module</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (quarkus-module)</name>
    <description>Quarkus / ArC adapter for jawelte. Drives the ArC container lifecycle from a regular JUnit extension by calling io.quarkus.arc.processor.BeanProcessor as a library at test time (the same code path Quarkus's own QuarkusComponentTest uses). Tests do NOT need @QuarkusTest — applying @EnableTestBeans is enough. No Quarkus build-time extension (no @BuildStep / quarkus-extension.yaml / runtime+deployment artifact pair) — everything is plain code in this single jar.</description>

    <dependencyManagement>
        <dependencies>
            <!--
                Quarkus BOM scoped to this module only. Imported here
                rather than in the root pom because the BOM overrides
                smallrye-config / jackson / commons-io / etc. versions
                across the whole reactor — propagating those to
                non-Quarkus modules breaks bean discovery in OWB / Weld
                (concretely surfaced previously as wiremock-module
                scenario-04 ambiguity).
            -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
        </dependency>

        <!--
            ArC's build-time bean processor exposed as a library. Used
            at TEST RUNTIME (not build time) to programmatically
            register synthetic mock beans, apply @TestBean
            alternatives, and build the ArC deployment. Same path
            Quarkus's own QuarkusComponentTest uses internally.
        -->
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc</artifactId>
        </dependency>

        <!--
            Mockito creates the actual mock instances inside
            MockBeanCreator. Marked provided so consumers explicitly
            opt in via their own test classpath, mirroring
            cdi-module/impl's stance on Mockito.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>
</project>
