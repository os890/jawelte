<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-quarkus-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-quarkus-module-deployment</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (quarkus-module/deployment)</name>
    <description>Deployment half of the jawelte Quarkus extension. Hosts the @BuildStep methods that replace cdi-module's portable TestBeansCdiExtension: discovery of @EnableTestBeans config and @TestBean alternatives, AnnotationTransformation to add @Priority + fallback @Singleton, SyntheticBeanBuildItem registration for inline-@TestBean static field beans and auto-mock beans (one per unsatisfied (targetType, qualifier-set) IpKey).</description>

    <dependencies>
        <!--
            All scopes inherited from jawelte-parent's
            <dependencyManagement>. Quarkus artifact versions come
            from the quarkus-bom import.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-quarkus-module-runtime</artifactId>
        </dependency>

        <!--
            quarkus-arc-deployment ships the build-time ArC SPIs
            (BeanRegistrar, AnnotationTransformation, ContextRegistrar)
            we drive from @BuildStep methods. quarkus-core-deployment
            ships the Quarkus build-step framework itself
            (@BuildStep, BuildItem subclasses, BuildProducer<>).
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc-deployment</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-core-deployment</artifactId>
        </dependency>
    </dependencies>
</project>
