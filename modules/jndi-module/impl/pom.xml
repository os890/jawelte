<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jndi-module</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jndi-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jndi-module/impl)</name>
    <description>DefaultJndiContextProvider at @Priority(Integer.MAX_VALUE): installs Apache XBean's naming provider once per JVM and returns its writable global context, so every module that binds shares one root. The root is built with supportReferenceable off, so a lookup returns the object that was bound rather than a fresh reconstruction of it - xbean's default replaces a bound Referenceable with its Reference at bind time, which would give a pooled DataSource one pool per lookup. xbean-naming is a provided dependency - compiled against, but not inherited by anything that takes this jar - and all of its types are confined to XbeanNamingTree, which is only loaded once a Class.forName probe has confirmed the provider is there. A JVM with no naming provider gets null from the port rather than an error, and never has its java.naming.* properties touched.</description>

    <dependencies>
        <!--
            jndi-module/api supplies the JndiContextProvider port this
            module implements.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jndi-module-api</artifactId>
        </dependency>

        <!--
            jakarta.annotation-api supplies @Priority. provided scope
            (inherited).
        -->
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>

        <!--
            xbean-naming is the naming implementation this adapter
            installs, so it is compiled against rather than reflected
            over - the same shape jpa-module uses for
            xbean-finder-shaded.

            provided scope (overriding the test scope the root pom
            manages it at, since that default is aimed at the scenarios
            that bring a provider for their own test run): available
            when this module is compiled, and NOT transitive, so nothing
            that takes jndi-module-impl inherits a naming provider from
            it. That is what keeps "no provider in this JVM" a reachable
            state - tests/jndi-module scenario 02 asserts it - and it
            keeps a consumer free to supply a different provider.
        -->
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-naming</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
