<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jndi-module</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jndi-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jndi-module/api)</name>
    <description>Ships exactly one port: JndiContextProvider, which hands out the single writable root of the in-process JNDI naming tree. javax.naming is in the JDK, so the only dependency is jawelte-core-api - for TestContext.loadService(...), the project-wide SPI lookup the port is resolved through.</description>

    <dependencies>
        <!--
            core-api supplies TestContext.loadService(...), the
            project-wide mechanism this port is resolved through. The
            dependency points that way and only that way: the core
            knows nothing about naming.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
