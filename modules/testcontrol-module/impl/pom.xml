<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-testcontrol-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-testcontrol-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (testcontrol-module/impl)</name>
    <description>Implementation of testcontrol-module: TestControlCdiExtension (the CDI Extension that unconditionally remaps every @ConfigBean class from @ApplicationScoped to @TestClassScoped during ProcessAnnotatedType), and — added in later phases — TestControlLifecycleAdapter, TestControlScopeObserver, and TestDataHandler. SPI lookups go through TestContext.loadService(...) — no compile-time dep on core/impl.</description>

    <dependencies>
        <!--
            testcontrol-module/api supplies the @TestControl annotation
            that downstream classes (TestControlLifecycleAdapter,
            TestDataHandler, TestControlScopeObserver) read off the
            active test method.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-api</artifactId>
        </dependency>

        <!--
            core-api supplies @ConfigBean (the stereotype this module's
            CDI Extension scans for) and — for later phases — the
            TestModuleLifecyclePort + TestContext infrastructure.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            scope-module/api supplies @TestClassScoped (the target
            scope of the @ConfigBean remap) and @TestMethodScoped for
            the startScopes filter.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
        </dependency>

        <!--
            db-testdata-module/api supplies DbSeed + DbDiff fluent
            builders consumed by TestDataHandler.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
            jakarta.transaction-api supplies @Transactional, used on
            the TestDataSeedTransactionTemplate proxy bean to drive
            the seed phase inside a transactional context. The
            interceptor implementation is provided at test runtime by
            jta-module (whatever TransactionStrategy is active —
            Geronimo, Narayana, Atomikos) when @TestControl(testData=…)
            is in use.
        -->
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>

        <!--
            jakarta.persistence-api supplies EntityManager, looked up
            via CDI inside TestDataSeedTransactionTemplate to populate
            jpa-module's active-PU stack before DbSeed.forPersistenceUnit()
            resolves a connection.
        -->
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>

        <!--
            junit-jupiter-api supplies ExtensionContext (read off
            TestContext under the ExtensionContext.class key bound by
            core/impl's DelegatingJUnitExtension) and the
            AnnotationSupport.findAnnotation helper used to resolve
            @TestControl on the active test method with JUnit Jupiter's
            class-hierarchy walk semantics. provided scope (inherited
            from the parent's dependencyManagement) — consumers bring
            their own JUnit version.
        -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
