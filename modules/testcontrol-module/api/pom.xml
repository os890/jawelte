<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-testcontrol-module</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-testcontrol-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (testcontrol-module/api)</name>
    <description>Ships the @TestControl annotation only. @Target(METHOD), @Retention(RUNTIME), @Documented; deliberately NOT @Inherited (Java's @Inherited applies to class-level annotations only — cross-class inheritance over test methods comes from JUnit Jupiter's AnnotationSupport.findAnnotation class-hierarchy walk). Zero external compile dependencies: all annotation attributes (Class&lt;? extends Annotation&gt;[], String[], String) resolve through java.lang.annotation.</description>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
