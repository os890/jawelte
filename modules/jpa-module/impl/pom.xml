<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jpa-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jpa-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jpa-module/impl)</name>
    <description>Implementation of jawelte's JPA integration. Hosts JpaLifecycleAdapter (TestModuleLifecyclePort, @Priority(200)), JpaCdiExtension, the @Transactional / @ReadOnly interceptors, the @TransactionScoped Context, the JVM-wide EMF cache, the EntityManager proxy, the per-thread EM stack, the table cleaner, the UserTransaction impl, the default RESOURCE_LOCAL TransactionStrategy, and the ASM-based entity scanner.</description>

    <dependencies>
        <!--
            Compile deps. All scopes inherited from jawelte-parent's
            <dependencyManagement>. jpa-module/impl compile-depends on
            cdi-module/api so that JpaTypesExcludedPackageFilter can
            implement the auto-mock exclude SPI cdi-module ships;
            cross-module wiring otherwise goes through TestContext /
            TestModuleLifecyclePort and the CDI runtime — no
            compile-time dep on cdi-module/impl or scope-module.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>

        <!--
            Hibernate ORM is pulled in at provided scope so jpa-module
            can call HibernatePersistenceProvider.createContainerEntityManagerFactory
            with a custom PersistenceUnitInfo when persistence.xml has
            no <class> entries (auto-discovery path). Consumers running
            against another JPA provider would need to swap this out.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            opentest4j ships TestAbortedException, which jpa-module's
            lifecycle adapter throws to skip subsequent test methods
            when @PersistenceConfig(fileMode=true) is active. provided
            scope: every JUnit-driven consumer brings opentest4j
            transitively via junit-jupiter-api, so we don't impose a
            version.
        -->
        <dependency>
            <groupId>org.opentest4j</groupId>
            <artifactId>opentest4j</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
