<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jpa-module</artifactId>
        <version>0.4.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jpa-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jpa-module/impl)</name>
    <description>Implementation of jawelte's JPA integration. Hosts JpaLifecycleAdapter (TestModuleLifecyclePort, @Priority(200)), JpaCdiExtension, the @Transactional / @ReadOnly interceptors, the @TransactionScoped Context, the JVM-wide EMF cache, the EntityManager proxy, the per-thread EM stack, the table cleaner, the UserTransaction impl, the default RESOURCE_LOCAL TransactionStrategy, and the ASM-based entity scanner.</description>

    <dependencies>
        <!--
            Compile deps. All scopes inherited from jawelte-parent's
            <dependencyManagement>. jpa-module/impl has no compile-time
            dep on cdi-module: it contributes to cdi-module's
            auto-mock exclude list through the ConfigKeyAliasProvider
            SPI in core/api, switching on the literal logical-key
            string (no import). Cross-module wiring otherwise goes
            through TestContext / TestModuleLifecyclePort and the CDI
            runtime.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jpa-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jndi-module/api supplies JndiContextProvider, the shared
            naming tree a persistence unit's <jta-data-source> name is
            resolved in. Interfaces only, and it means jpa-module needs
            no dependency on datasource-module: any module binding a
            data source under that name is resolved the same way, which
            is also what a real container does with the element.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jndi-module-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.persistence</groupId>
            <artifactId>jakarta.persistence-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.ow2.asm</groupId>
            <artifactId>asm</artifactId>
        </dependency>
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-finder-shaded</artifactId>
        </dependency>

        <!--
            Hibernate ORM is pulled in at provided scope so jpa-module
            can call HibernatePersistenceProvider.createContainerEntityManagerFactory
            with a custom PersistenceUnitInfo when persistence.xml has
            no <class> entries (auto-discovery path). Consumers running
            against another JPA provider would need to swap this out.
        -->
        <dependency>
            <groupId>org.hibernate.orm</groupId>
            <artifactId>hibernate-core</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            opentest4j ships TestAbortedException, which jpa-module's
            lifecycle adapter throws to skip subsequent test methods
            when @PersistenceConfig(fileMode=true) is active. provided
            scope: every JUnit-driven consumer brings opentest4j
            transitively via junit-jupiter-api, so we don't impose a
            version.
        -->
        <dependency>
            <groupId>org.opentest4j</groupId>
            <artifactId>opentest4j</artifactId>
            <scope>provided</scope>
        </dependency>

        <!--
            junit-platform-launcher hosts the LauncherSessionListener SPI
            that JpaLauncherSessionListener implements. provided scope:
            JUnit-driven consumers bring it transitively via Surefire's
            runtime classpath, so jpa-module never imposes the version.
            jpa-module ships NO META-INF/services entry for this SPI —
            consumers opt in by registering JpaLauncherSessionListener
            in their own classpath.
        -->
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-launcher</artifactId>
            <scope>provided</scope>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
