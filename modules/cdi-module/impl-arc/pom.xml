<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-cdi-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-cdi-module-impl-arc</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (cdi-module/impl)</name>
    <description>ArC-based adapter for jawelte. Drives Quarkus's ArC container lifecycle from a regular JUnit extension by invoking io.quarkus.arc.processor.BeanProcessor as a library at test time. Hosts CdiTestBeanContainer (TestBeanContainerPort impl), the bean creators (Mockito-backed mocks, @TestBean inline fields), and the default filter implementations.</description>

    <dependencyManagement>
        <dependencies>
            <!--
                Quarkus BOM scoped to cdi-module/impl. Imported here
                rather than in the root pom because the BOM overrides
                smallrye-config / jackson / commons-io / etc. versions —
                propagating those to non-CDI modules would break
                unrelated dependencies.
            -->
            <dependency>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-bom</artifactId>
                <version>${quarkus.version}</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>

        <!--
            ArC build-time bean processor exposed as a library. Used at
            test runtime to programmatically register synthetic mock
            beans, apply @TestBean alternatives, and build the ArC
            deployment.
        -->
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc-processor</artifactId>
        </dependency>
        <dependency>
            <groupId>io.quarkus.arc</groupId>
            <artifactId>arc</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
