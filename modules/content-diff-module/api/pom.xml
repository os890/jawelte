<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-content-diff-module</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-content-diff-module-api</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (content-diff-module/api)</name>
    <description>Fluent ContentDiff entry point + JsonBuilder / XmlBuilder builders + Difference / DiffOptions records + the DiffEngine SPI port. No JSON / XML library imports — the api jar loads cleanly even when no engine is on the classpath. Routes engine lookup through core/api's TestContext.loadService(ServicePriorityResolver.class) + ServiceLoader.load(DiffEngine.class) so the project-wide priority sort applies; engines are filtered by contentType() and the lowest-priority winner is cached per JVM.</description>

    <dependencies>
        <!--
            core-api supplies TestContext.loadService(...) +
            ServicePriorityResolver + ConfigResolver. ContentDiff caches
            engines through the priority resolver and reads its two
            default-ignore MP Config keys through ConfigResolver.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
