<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-jaxrs-module</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-jaxrs-module-impl</artifactId>
    <packaging>jar</packaging>

    <name>jawelte (jaxrs-module/impl)</name>
    <description>Implementation of jaxrs-module: JaxRsLifecycleAdapter (TestModuleLifecyclePort at @Priority(75) — between testcontrol at 50 and scope at 100; boots SeBootstrap on port 0 in beforeAll, shuts it down in afterAll); TestUrlHolder (the TestUrl impl bean exposing the resolved base URL, carrying the impl-internal @JaxRsManaged marker); TestUrlScopeRemap (a core/api BeanScopeMapper provider that, triggered by that marker, upgrades only TestUrlHolder to @TestClassScoped when scope-module is on the classpath — resolved reflectively via MP Config, so no compile-time dep on scope-module; the bean stays @ApplicationScoped otherwise); CdiIntegrationFilter (a JAX-RS ContainerRequestFilter/ContainerResponseFilter pair activating @RequestScoped per HTTP request via RequestContextController). SPI lookups go through TestContext.loadService(...) — no compile-time dep on core/impl.</description>

    <dependencies>
        <!--
            jaxrs-module/api supplies @EnableJaxRs (read off the active
            test class by JaxRsLifecycleAdapter), TestUrl (implemented
            by TestUrlHolder), and ResponseDiff (api-side utility, not
            referenced from impl but bundled as a transitive runtime
            dep for the consumer test classpath).
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-api</artifactId>
        </dependency>

        <!--
            core-api supplies the TestModuleLifecyclePort + TestContext
            infrastructure that JaxRsLifecycleAdapter implements and
            reads through TestContext.loadService(...) at boot time.
            SPI-only — no compile-time dep on core/impl.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
        </dependency>

        <!--
            jakarta.enterprise.cdi-api supplies the RequestContextController
            used by CdiIntegrationFilter to activate @RequestScoped per HTTP
            request. provided scope.
        -->
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
        </dependency>

        <!--
            jakarta.ws.rs-api supplies SeBootstrap (booted in
            beforeAll), Response, ContainerRequestFilter +
            ContainerResponseFilter (implemented by
            CdiIntegrationFilter). provided scope.
        -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
        </dependency>

        <!--
            microprofile-config-api is reserved for any future MP
            Config keys jaxrs-module/impl might consume internally.
            Currently zero impl-side keys (the two ContentDiff
            default-ignore keys contributed by TICKET-011 live on
            TICKET-008's surface), but kept here as a near-zero-cost
            provided dependency for forward-compatibility.
        -->
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <executions>
                    <execution>
                        <id>javadoc-jar</id>
                        <phase>verify</phase>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
