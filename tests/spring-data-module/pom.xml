<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-spring-data-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/spring-data-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-spring-data-module. Each scenario boots a CDI container (via cdi-module) so spring-data-module's CDI extension is loaded, a Spring Data repository interface is auto-discovered, and the real implementation (built by JpaRepositoryFactory) dispatches to jpa-module's transaction-scoped EntityManager against an H2 database. Scenarios run under either OpenWebBeans (-Powb, default) or Weld (-Pweld).</description>

    <modules>
        <module>scenario-01-repository-injectable</module>
        <module>scenario-02-crud-operations</module>
        <module>scenario-03-derived-query-method</module>
        <module>scenario-04-query-annotation-jpql</module>
        <module>scenario-05-query-annotation-native</module>
        <module>scenario-06-mixed-em-and-repository</module>
        <module>scenario-07-service-with-transactional</module>
        <module>scenario-08-back-off-on-user-produces</module>
        <module>scenario-09-no-repository-bean-skipped</module>
        <module>scenario-10-no-repository-bean-on-parent</module>
        <module>scenario-11-limit-to-test-beans</module>
        <module>scenario-12-request-scoped-per-test-method</module>
        <module>scenario-13-paging-and-sorting</module>
        <module>scenario-14-multiple-repositories</module>
    </modules>

