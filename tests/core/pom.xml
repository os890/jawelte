<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-core</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/core aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-core orchestration. Centralizes the shared test dependencies (core-api / core-impl / JUnit / AssertJ / junit-platform-testkit) so each scenario pom stays minimal.</description>

    <modules>
        <module>scenario-01-proxy-resolves-delegating-extension</module>
        <module>scenario-02-priority-ordering-before</module>
        <module>scenario-03-priority-ordering-after-lifo</module>
        <module>scenario-04-no-priority-last</module>
        <module>scenario-05-testcontext-binding</module>
        <module>scenario-10-zero-container-managers</module>
        <module>scenario-11-multiple-container-managers</module>
        <module>scenario-15-error-propagation</module>
        <module>scenario-19-afterall-throws-fresh-testcontext</module>
        <module>scenario-20-multiple-aftereach-failures</module>
        <module>scenario-21-test-fail-and-aftereach-fail</module>
        <module>scenario-22-beforeall-throws-afterall-runs</module>
        <module>scenario-23-equal-priority-classname-tiebreak</module>
        <module>scenario-24-custom-resolver-orders-lifecycle-ports</module>
        <module>scenario-25-config-alias-providers-cached</module>
        <module>scenario-proxy-no-provider</module>
        <module>scenario-proxy-multi-provider</module>
        <module>scenario-config-01-dot-key-resolves</module>
        <module>scenario-config-02-underscore-fallback</module>
        <module>scenario-config-03-neither-key-set</module>
        <module>scenario-config-04-both-keys-dot-wins</module>
        <module>scenario-config-05-key-without-dot-no-fallback</module>
        <module>scenario-config-06-key-without-dot-not-set</module>
        <module>scenario-config-07-null-key</module>
        <module>scenario-config-08-alias-aggregation</module>
        <module>scenario-quarkus-auto-skip</module>
    </modules>

    <dependencies>
        <!--
            jawelte API is required by every scenario; core-impl is not,
            because scenario-proxy-no-provider deliberately runs WITHOUT
            core-impl on its classpath to verify the proxy's
            "No TestBeansExtension found" error. Each scenario's own pom
            adds jawelte-core-impl when needed.

            jawelte-core-api and the Jakarta APIs default to compile /
            provided in the parent's <dependencyManagement>; tests need
            them on the test classpath, so the scope is overridden here.
            JUnit and AssertJ already default to test scope in the
            parent and are inherited without an override.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>
</project>
