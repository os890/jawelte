<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-lnp-module</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-lnp-module-scenario-05-full-crud-rest-with-dbunit</artifactId>
    <packaging>jar</packaging>

    <name>jawelte tests/lnp-module scenario 05: full-crud-rest-with-dbunit</name>
    <description>Mirrors scenario-02's 21 CRUD methods but every method goes through a JAX-RS endpoint hosted by jaxrs-module's embedded SeBootstrap server instead of touching EntityManager directly. Combines @TestControl (testcontrol + db-testdata-module) for the dbIn/dbExpected diff with ResponseDiff.forJson (jaxrs-module → content-diff bridge) for the HTTP response assertion, exercising as many jawelte features as one scenario can in a single sweep.</description>

    <dependencies>
        <!--
            Same testcontrol + db-testdata + scope stack as scenario-02:
            @TestControl drives dbIn/ seed and dbExpected/ diff, and
            scope-module supplies the contextual lifecycle bits the
            jaxrs ContainerRequestFilter relies on.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jaxrs-module: @EnableJaxRs, TestUrl, ResponseDiff (api),
            JaxRsLifecycleAdapter and CdiIntegrationFilter (impl).
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            content-diff-module: the JSON engine ResponseDiff.forJson
            bridges into. api is on jaxrs-module's transitive surface
            via ResponseDiff; impl is the runtime that performs the
            actual ContentDiff comparison.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            jakarta.ws.rs-api supplies SeBootstrap, Response, the
            javax-equivalents the @Path/@GET/... annotations need, plus
            ClientBuilder used by the abstract test base.
        -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            JSON-P (jakarta.json + Parsson) for building the entity
            response payloads in the resource. JSON-P is the data-only
            half of the Jakarta JSON stack — no JAX-RS provider
            registration needed. The resource builds a JsonArray /
            JsonObject and returns its toString() as the response body
            (Content-Type: application/json).
        -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            JAX-RS provider selection mirrors tests/jaxrs-module's
            -Pcxf / -Presteasy split. CXF is the default; resteasy is
            available for the opt-in matrix and so jaxrs scenarios in
            the lnp sweep can target either provider without code
            changes.
        -->
        <profile>
            <id>cxf</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-frontend-jaxrs</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-transports-http-jetty</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-rs-client</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>resteasy</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-core</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-undertow</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-client</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
