<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-lnp-module</artifactId>
        <version>0.2.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-lnp-module-scenario-06-full-crud-roundtrip</artifactId>
    <packaging>jar</packaging>

    <name>jawelte tests/lnp-module scenario 06: full-crud-roundtrip</name>
    <description>A single test method per class drives a full CRUD HTTP roundtrip (GET-list, POST, GET-list, PUT, GET-one, DELETE, GET-list) against a small standalone Customer entity. Combines testcontrol/db-testdata (dbIn seed + dbExpected verify) with jaxrs ResponseDiff per step. 50 numbered subclasses amplify the per-class signal so the LNP report can compare the roundtrip's overhead against scenarios 01-05.</description>

    <dependencies>
        <!--
            Same testcontrol + db-testdata + scope stack as scenarios
            02 / 03 / 05: @TestControl drives dbIn / dbExpected.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jaxrs-module: @EnableJaxRs, TestUrl, ResponseDiff (api), lifecycle adapter (impl). -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- content-diff-module: ContentDiff.forJson backs the per-step ResponseDiff. -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- jakarta.ws.rs-api for SeBootstrap / Response / ClientBuilder / Path. -->
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>test</scope>
        </dependency>

        <!-- JSON-P (Parsson + api) for building entity-shaped responses. -->
        <dependency>
            <groupId>jakarta.json</groupId>
            <artifactId>jakarta.json-api</artifactId>
            <version>2.1.3</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.parsson</groupId>
            <artifactId>parsson</artifactId>
            <version>1.1.7</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>cxf</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-frontend-jaxrs</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-transports-http-jetty</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-rs-client</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>resteasy</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-core</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-undertow</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-client</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
