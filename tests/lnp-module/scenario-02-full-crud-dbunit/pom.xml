<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-lnp-module</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-lnp-module-scenario-02-full-crud-dbunit</artifactId>
    <packaging>jar</packaging>

    <name>jawelte tests/lnp-module scenario 02: full-crud-dbunit</name>
    <description>Mirrors scenario-01-full-crud's 21 CRUD methods but seeds via db-testdata-module's @TestControl(testData=...) (dbIn/*.xml) and verifies via DbDiff against dbExpected/*.xml. Runs in the same lnp profile sweep so the per-class summary table shows scenario-01 (programmatic) and scenario-02 (db-unit) lines next to each other.</description>

    <dependencies>
        <!--
            scenario-02-only additions on top of the aggregator's
            base dep set: scope-module + testcontrol-module bring
            the @TestControl observer and its dbExpected verify
            phase; db-testdata-module supplies the DbSeed / DbDiff
            entry points that @TestControl delegates to.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-testcontrol-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-db-testdata-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
