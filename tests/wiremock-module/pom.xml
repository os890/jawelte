<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-wiremock-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/wiremock-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-wiremock-module. Each scenario boots a CDI container (via cdi-module + scope-module) so wiremock-module's lifecycle adapter, CDI producer (the api↔library bridge), CDI extension (@WireMockEndpoint discovery + synthetic-bean registration), and BeanScopeMapper SPI provider (registry-marker → @TestClassScoped) run end-to-end against real WireMockServer instances. Scenarios run under either OpenWebBeans (-Powb, default) or Weld (-Pweld) for the CDI runtime — there is no WireMock provider profile (only one WireMock implementation exists).</description>

    <modules>
        <module>scenario-01-single-endpoint-default-mode</module>
        <module>scenario-02-stub-registration</module>
        <module>scenario-03-stubs-reset-between-methods</module>
        <module>scenario-04-multi-endpoint-fixed-ports</module>
        <module>scenario-05-random-port</module>
        <module>scenario-06-meta-annotation-discovery</module>
        <module>scenario-07-wiremock-and-wiremockserver-share-endpoint</module>
        <module>scenario-08-unqualified-with-one-endpoint</module>
        <module>scenario-09-unqualified-with-multiple-endpoints</module>
        <module>scenario-10-server-stopped-after-class</module>
        <module>scenario-11-no-endpoint-qualifiers</module>
        <module>scenario-12-multiple-test-classes</module>
        <module>scenario-13-fixed-port-conflict</module>
        <module>scenario-14-https-state-not-configured</module>
        <module>scenario-15-enable-wiremock-alone-boots-the-lifecycle</module>
        <module>scenario-16-producer-satisfies-default-injection</module>
        <module>scenario-17-scope-sandwich</module>
        <module>scenario-18-registry-remapped-to-testclassscoped</module>
        <module>scenario-19-beanscopemapper-sl-wired</module>
        <module>scenario-20-independence-from-jaxrs-module</module>
        <module>scenario-21-wiremockruntimeinfo-default-injection</module>
        <module>scenario-22-wiremockruntimeinfo-qualified-injection</module>
        <module>scenario-23-enablewiremock-inherited</module>
        <module>scenario-24-priority-resolves-default</module>
        <module>scenario-25-priority-tie-stays-ambiguous</module>
    </modules>

    <dependencies>
        <!--
            Same dep shape as tests/jaxrs-module: every scenario
            brings up a CDI container via cdi-module and exercises
            wiremock-module on top of it. scope=test on the impl
            jars so JaCoCo indexes the production classes for
            coverage.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-wiremock-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            CDI SE runtime selection. Mirrors the same -Powb / -Pweld
            split used by every other tests/<module>/pom.xml in the
            project. No WireMock provider profile — only one
            WireMock implementation exists; the wiremock library is
            brought in transitively via jawelte-wiremock-module-impl.
        -->
        <profile>
            <id>owb</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-cdi-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-scope-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-wiremock-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>**/*QuarkusTest.java</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*QuarkusTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>weld</id>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-cdi-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-scope-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-wiremock-module-impl</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-compiler-plugin</artifactId>
                        <configuration>
                            <testExcludes>
                                <exclude>**/*QuarkusTest.java</exclude>
                            </testExcludes>
                        </configuration>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <excludes>
                                <exclude>**/*QuarkusTest.java</exclude>
                            </excludes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
        <profile>
            <id>quarkus</id>
            <dependencies>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-cdi-module-impl-arc</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-scope-module-impl-arc</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-wiremock-module-impl-arc</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-cdi-module-deployment</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>${project.groupId}</groupId>
                    <artifactId>jawelte-scope-module-deployment</artifactId>
                    <scope>test</scope>
                </dependency>
                <dependency>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-junit5</artifactId>
                    <scope>test</scope>
                </dependency>
            </dependencies>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-enforcer-plugin</artifactId>
                        <executions>
                            <!--
                                Quarkus's bootstrap dep-resolver chain
                                pulls javax.inject / javax.annotation
                                transitively (quarkus-test-common ->
                                quarkus-bootstrap-maven-resolver ->
                                maven-embedder). The project-wide ban
                                on javax.* doesn't apply to bootstrap
                                code that never reaches the
                                Jakarta-namespaced runtime under test.
                            -->
                            <execution>
                                <id>enforce-rules</id>
                                <phase>none</phase>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-surefire-plugin</artifactId>
                        <configuration>
                            <includes>
                                <include>**/*QuarkusTest.java</include>
                            </includes>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
