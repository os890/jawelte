<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-jaxrs-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/jaxrs-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-jaxrs-module. Each scenario boots a CDI container (via cdi-module + scope-module) so jaxrs-module's lifecycle adapter, TestUrlScopeRemap (the BeanScopeMapper provider upgrading TestUrlHolder to @TestClassScoped — scope-module also contributes the @SessionScoped→@TestMethodScoped remap), TestUrlHolder bean, and CdiIntegrationFilter run end-to-end against a live embedded JAX-RS server. Scenarios run under either OpenWebBeans (-Powb, default) or Weld (-Pweld) for the CDI runtime, crossed with Apache CXF (-Pcxf, default) or RESTEasy (-Presteasy) for the JAX-RS provider — the two axes are orthogonal Maven profiles.</description>

    <modules>
        <module>scenario-01-server-starts-on-random-port</module>
        <module>scenario-02-get-request-returns-body</module>
        <module>scenario-03-post-request-creates-resource</module>
        <module>scenario-04-cdi-injection-in-resource</module>
        <module>scenario-05-request-scoped-bean-per-request</module>
        <module>scenario-06-session-scoped-remapped-to-test-method-scoped</module>
        <module>scenario-07-response-diff-json</module>
        <module>scenario-08-response-diff-xml</module>
        <module>scenario-09-multiple-resource-classes</module>
        <!--
            scenario-10-server-stops-after-test-class: temporarily
            commented out — the TCP-probe assertion is timing-sensitive
            against CXF's Jetty transport (Server.stop() returns before
            the listening socket is fully released on some kernels).
            The files stay in the tree; needs a more deterministic
            verification mechanism (e.g. a CDI ContainerStopping event
            observer) before re-enabling.
        -->
        <module>scenario-11-exception-mapper</module>
        <module>scenario-12-enable-jaxrs-alone-boots-the-lifecycle</module>
        <module>scenario-15-test-url-called-before-server-start</module>
        <module>scenario-16-session-scoped-remap-is-global</module>
        <module>scenario-17-dependent-resource-per-request</module>
        <module>scenario-18-plain-resource-via-reflective-fallback</module>
        <module>scenario-19-unknown-path-returns-404</module>
        <module>scenario-20-full-crud-roundtrip</module>
        <module>scenario-21-test-url-upgraded-to-testclassscoped</module>
        <module>scenario-22-test-url-stays-applicationscoped-without-scope-module</module>
    </modules>

    <dependencies>
        <!--
            Same dep shape as tests/scope-module / tests/testcontrol-module:
            every scenario brings up a CDI container via cdi-module and
            exercises jaxrs-module on top of it. scope=test on the impl
            jars so JaCoCo indexes the production classes for coverage.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-scope-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-jaxrs-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            content-diff-module is consumed by the ResponseDiff
            scenarios (forJson / forXml). Pulling api + impl here
            spares each ResponseDiff scenario from declaring the pair.
            The api jar is transitively brought in by jaxrs-module-api
            anyway; declaring it explicitly at test scope keeps the
            JaCoCo coverage attribution clean.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-content-diff-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.ws.rs</groupId>
            <artifactId>jakarta.ws.rs-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            CDI SE runtime selection. Mirrors the same -Powb / -Pweld
            split used by every other tests/<module>/pom.xml in the
            project.
        -->
        <profile>
            <id>owb</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>weld</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                </dependency>
            </dependencies>
        </profile>

        <!--
            JAX-RS provider selection. Orthogonal to the CDI runtime
            profile above; the resulting 2x2 matrix is opt-in via the
            CLI (-Pweld and/or -Presteasy). Exactly one impl is on
            the test classpath in any single build, so
            SeBootstrap.newInstance()'s ServiceLoader picks it
            unambiguously.
        -->
        <profile>
            <id>cxf</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-frontend-jaxrs</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-transports-http-jetty</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.apache.cxf</groupId>
                    <artifactId>cxf-rt-rs-client</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>resteasy</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-core</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-undertow</artifactId>
                </dependency>
                <dependency>
                    <groupId>org.jboss.resteasy</groupId>
                    <artifactId>resteasy-client</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
