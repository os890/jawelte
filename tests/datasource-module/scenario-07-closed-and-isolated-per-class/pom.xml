<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-datasource-module</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-datasource-module-scenario-07-closed-and-isolated-per-class</artifactId>
    <packaging>jar</packaging>
    <name>jawelte tests/datasource-module scenario 07: data sources are closed and not shared across test classes</name>
    <description>Verifies the end of the lifecycle: a closeable vendor DataSource is closed in afterAll, and a second test class gets its own freshly built instance rather than the previous class's. Both subject classes are driven through EngineTestKit so the assertions can run after their containers have shut down.</description>

    <dependencies>
        <!--
            The in-process JNDI provider core/impl installs. Declared
            per scenario rather than in the parent so that scenario 06
            can run without one.
        -->
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-naming</artifactId>
        </dependency>
    </dependencies>
</project>
