<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-datasource-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/datasource-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-datasource-module. Each scenario boots a CDI container (via cdi-module) so the @DataSourceDefinition discovery extension, the DataSourceLifecycleAdapter and the reflective factory run end-to-end against H2. Each scenario that needs a JNDI provider declares xbean-naming itself, so scenario 06 can run without one and assert the documented degradation. No jpa-module and no jta-module dependency anywhere in this tree — that datasource-module stands alone is part of what these scenarios assert.</description>

    <modules>
        <module>scenario-01-single-definition-injected-and-bound</module>
        <module>scenario-02-multiple-definitions-named</module>
        <module>scenario-03-no-definition-is-inert</module>
        <module>scenario-04-definition-on-bean-class</module>
        <module>scenario-05-all-jndi-namespaces</module>
        <module>scenario-06-no-naming-provider-degrades</module>
        <module>scenario-07-closed-and-isolated-per-class</module>
        <module>scenario-08-datasource-factory-swap</module>
        <module>scenario-09-named-injection-in-application-bean</module>
        <module>scenario-10-startup-observer-uses-datasource</module>
        <module>scenario-11-url-redirected-by-config</module>
    </modules>

    <dependencies>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-datasource-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-datasource-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
        </dependency>

        <!--
            xbean-naming is deliberately NOT declared here. It is the
            in-process JNDI provider core/impl installs, and scenario 06
            exists precisely to run without one — a dependency inherited
            from this parent could not be removed by a child, so each
            scenario that wants naming declares it itself.
        -->

        <!--
            H2 is the vendor whose org.h2.jdbcx.JdbcDataSource the
            scenarios name in their @DataSourceDefinition. It is a
            test-classpath concern of the scenario, not of
            datasource-module, which ships no driver dependency.
        -->
        <dependency>
            <groupId>com.h2database</groupId>
            <artifactId>h2</artifactId>
        </dependency>

        <!--
            cdi-module's auto-mock path instantiates Mockito mocks for
            unsatisfied injection points during AfterBeanDiscovery, so
            it has to be on the classpath even though no scenario here
            stubs anything.
        -->
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <profile>
            <id>owb</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>weld</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
