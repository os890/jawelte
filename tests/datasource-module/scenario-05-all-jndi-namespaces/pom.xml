<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-datasource-module</artifactId>
        <version>0.3.0</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-datasource-module-scenario-05-all-jndi-namespaces</artifactId>
    <packaging>jar</packaging>
    <name>jawelte tests/datasource-module scenario 05: every standard JNDI namespace resolves</name>
    <description>Verifies that a declared name in each of the four standard Jakarta namespaces - java:comp/env, java:module, java:app and java:global - is bound and resolves, so the binder's sub-context creation is not specific to one prefix.</description>

    <dependencies>
        <!--
            The in-process JNDI provider core/impl installs. Declared
            per scenario rather than in the parent so that scenario 06
            can run without one.
        -->
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-naming</artifactId>
        </dependency>
    </dependencies>
</project>
