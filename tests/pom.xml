<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-parent</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests aggregator)</name>
    <description>Top-level aggregator for jawelte's test sub-modules. Each scenario lives in its own module so its classpath / META-INF/services is isolated.</description>

    <!--
        Same two profiles as modules/pom.xml, for the same reason and
        with the same guarantee: this POM declares no other profile, so
        the CDI-runtime / JTA-implementation / JAX-RS / lnp profiles of
        the per-module and per-scenario POMs never deactivate
        `all-modules`. `-P weld,minimal-modules` selects Weld and the
        released-dependencies-only subset at once.

        Note that `-P minimal-modules` only takes effect when the build
        goes THROUGH this aggregator. Invoking a test module by its own
        directory - which verify-all.sh does, one phase per profile
        combination - bypasses the list, so verify-all.sh always covers
        every module and is the all-modules gate by construction.
    -->
    <profiles>
        <profile>
            <id>all-modules</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <modules>
                <module>core</module>
                <module>cdi-module</module>
                <module>scope-module</module>
                <module>jpa-module</module>
                <module>jta-module</module>
                <module>ejb-module</module>
                <module>content-diff-module</module>
                <module>db-testdata-module</module>
                <module>testcontrol-module</module>
                <module>jaxrs-module</module>
                <module>wiremock-module</module>
                <module>batch-module</module>
                <module>spring-data-module</module>
                <!--
                    Needs org.os890.cdi.uml:dynamic-cdi-flow-renderer on
                    the classpath, which has no release yet:
                    https://github.com/os890/dynamic-cdi-flow-renderer
                -->
                <module>flow-assert-module</module>
                <module>lnp-module</module>
            </modules>
        </profile>
        <profile>
            <id>minimal-modules</id>
            <modules>
                <module>core</module>
                <module>cdi-module</module>
                <module>scope-module</module>
                <module>jpa-module</module>
                <module>jta-module</module>
                <module>ejb-module</module>
                <module>content-diff-module</module>
                <module>db-testdata-module</module>
                <module>testcontrol-module</module>
                <module>jaxrs-module</module>
                <module>wiremock-module</module>
                <module>batch-module</module>
                <module>spring-data-module</module>
                <module>lnp-module</module>
            </modules>
        </profile>
    </profiles>
</project>
