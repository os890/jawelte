    <artifactId>jawelte-tests-testcontrol-module-scenario-32-startscopes-vetoes-testmethodscoped</artifactId>
    <packaging>jar</packaging>

    <name>jawelte tests/testcontrol-module scenario 32: startscopes-vetoes-testmethodscoped</name>
    <description>testcontrol-module test scenario: @TestControl(startScopes=…) that omits @TestMethodScoped actually suppresses it — scope-module honors the BeforeScopeStarted veto, so a @TestMethodScoped bean throws ContextNotActiveException in that method, while a later method with no startScopes restriction resolves it normally.</description>
