<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-resource-module</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-resource-module-scenario-05-bare-resource-is-left-alone</artifactId>
    <packaging>jar</packaging>
    <name>jawelte tests/resource-module scenario 05: a bare @Resource is left exactly as it was</name>
    <description>The documented boundary, asserted rather than assumed. A @Resource with no lookup, mappedName or name has its name inferred from the declaring class and field in Jakarta EE - a much larger surface than this module covers. It must not be failed over: the deployment starts, the field stays null, and everything around it is unaffected.</description>

    <dependencies>
        <dependency>
            <groupId>org.apache.xbean</groupId>
            <artifactId>xbean-naming</artifactId>
        </dependency>
    </dependencies>
</project>
