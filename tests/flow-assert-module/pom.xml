<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.3.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-flow-assert-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/flow-assert-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte-flow-assert-module. Every scenario boots a CDI container through cdi-module, lets the cdi-flow recorder instrument its own beans, and compares the recording against an expected diagram in src/test/resources. The recorder comes in transitively via jawelte-flow-assert-module-impl, which is what makes "one dependency and an annotation" the whole integration.</description>

    <modules>
        <module>scenario-01-mermaid-match</module>
        <module>scenario-02-mermaid-mismatch</module>
        <module>scenario-03-plantuml-match</module>
        <module>scenario-04-combined-chains</module>
        <module>scenario-05-explicit-resource-and-ignoring</module>
        <module>scenario-06-fluent-single-chain</module>
        <module>scenario-07-recording-off-without-annotation</module>
        <module>scenario-08-custom-dialect-via-spi</module>
    </modules>

    <dependencies>
        <!--
            Same dep shape as tests/wiremock-module: every scenario
            brings up a CDI container via cdi-module and exercises
            flow-assert-module on top of it. scope=test on the impl
            jars so JaCoCo indexes the production classes for
            coverage.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-flow-assert-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-flow-assert-module-impl</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            The recorder is a compile-scope dependency of
            flow-assert-module/impl and therefore already on the test
            classpath; declared explicitly so the scenarios can name
            CallFlow / CallNode without relying on a transitive scope.
        -->
        <dependency>
            <groupId>org.os890.cdi.uml</groupId>
            <artifactId>dynamic-cdi-flow-renderer</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>jakarta.enterprise</groupId>
            <artifactId>jakarta.enterprise.cdi-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.annotation</groupId>
            <artifactId>jakarta.annotation-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>jakarta.inject</groupId>
            <artifactId>jakarta.inject-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.smallrye.config</groupId>
            <artifactId>smallrye-config</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>
        <dependency>
            <groupId>org.junit.platform</groupId>
            <artifactId>junit-platform-testkit</artifactId>
        </dependency>
        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <profiles>
        <!--
            CDI SE runtime selection. Mirrors the same -Powb / -Pweld
            split used by every other tests/<module>/pom.xml in the
            project: the recorder is a portable extension, so the same
            recording has to come out of either container.
        -->
        <profile>
            <id>owb</id>
            <activation>
                <activeByDefault>true</activeByDefault>
            </activation>
            <dependencies>
                <dependency>
                    <groupId>org.apache.openwebbeans</groupId>
                    <artifactId>openwebbeans-se</artifactId>
                </dependency>
            </dependencies>
        </profile>
        <profile>
            <id>weld</id>
            <dependencies>
                <dependency>
                    <groupId>org.jboss.weld.se</groupId>
                    <artifactId>weld-se-shaded</artifactId>
                </dependency>
            </dependencies>
        </profile>
    </profiles>
</project>
