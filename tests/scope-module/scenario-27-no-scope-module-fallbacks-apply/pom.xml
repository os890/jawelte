<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <!--
        scenario-27 is the only scope-module scenario that runs WITHOUT
        scope-module on the test classpath - it verifies cdi-module's
        TICKET-003 defaults are still in force when no scope-module
        provider binds the override records on TestContext. To avoid
        inheriting tests/scope-module/pom.xml's scope-module-impl test
        dep, this module's parent is tests/cdi-module/pom.xml directly.
        The aggregator at tests/scope-module/pom.xml still references
        this module for build ordering / coverage aggregation.
    -->
    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-cdi-module</artifactId>
        <version>0.2.0</version>
        <relativePath>../../cdi-module/pom.xml</relativePath>
    </parent>
    <artifactId>jawelte-tests-scope-module-scenario-27-no-scope-module-fallbacks-apply</artifactId>
    <packaging>jar</packaging>
    <name>jawelte tests/scope-module scenario 27: no scope-module - TICKET-003 fallbacks apply</name>
</project>
