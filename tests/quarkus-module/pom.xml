<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">

    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests</artifactId>
        <version>0.1.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>

    <artifactId>jawelte-tests-quarkus-module</artifactId>
    <packaging>pom</packaging>

    <name>jawelte (tests/quarkus-module aggregator and parent)</name>
    <description>Aggregator AND parent for the per-scenario test modules covering jawelte under @QuarkusTest. Mirrors tests/cdi-module's scenarios one-to-one (same scenario numbers); each scenario is a small Quarkus app whose test class carries @QuarkusTest + @EnableTestBeans. Gated by the -Pquarkus profile.</description>

    <modules>
        <module>scenario-01-interface-auto-mock</module>
        <module>scenario-02-concrete-class-auto-mock</module>
        <module>scenario-03-parameterized-generic</module>
        <module>scenario-04-named-qualifier</module>
        <module>scenario-05-custom-qualifier</module>
        <module>scenario-06-multiple-qualifiers</module>
        <module>scenario-08-constructor-injection</module>
        <module>scenario-09-initializer-method-injection</module>
        <module>scenario-10-producer-method-parameter</module>
        <module>scenario-11-observer-method-parameter</module>
        <module>scenario-12-satisfied-not-mocked</module>
        <module>scenario-13-testbean-bean</module>
        <module>scenario-16-testbean-repeatable</module>
        <module>scenario-17-testbean-meta-annotation</module>
        <module>scenario-22-same-simple-name</module>
        <module>scenario-34-alternative-without-scope</module>
        <module>scenario-35-testbean-not-alternative</module>
        <module>scenario-45-priority-resolver-tiebreak</module>
        <module>scenario-50-multi-alternative-same-type</module>
        <module>scenario-52-typed-narrowed-with-testbean</module>
        <module>scenario-54-binding-qualifier-member</module>
        <module>scenario-56-deltaspike-whitelist-allow</module>
    </modules>
    <!--
        Pending mirrors kept on disk but excluded from the reactor. The
        failures cluster into two groups:
          1. Quarkus owns the container lifecycle under @QuarkusTest, so
             jawelte's DelegatingJUnitExtension.beforeAll auto-skip
             never populates TestContext. Scenarios that assert about
             TestContext during jawelte's bootstrap window therefore
             don't apply under -Pquarkus: 39, 40, 41, 42, 46. Also
             scenario 30 (test-class field injection — Quarkus handles
             it) and 31 (test-class-not-CDI-bean — Quarkus registers
             the test class as a bean).
          2. Scenarios that exercise additional BuildStep features the
             processor doesn't yet implement: 44 (custom
             ServicePriorityResolver via MP Config — TestContext lookup
             timing), plus everything in the qualifier / @TestBean /
             whitelist / exclude-packages buckets.
    -->

    <dependencies>
        <!--
            jawelte-core-api + jawelte-core-impl are needed by every
            scenario (DelegatingJUnitExtension auto-skip path detects
            @QuarkusTest and cedes container ownership to Quarkus).
            jawelte-quarkus-module-runtime carries the Quarkus-flavour
            TestBeanContainerPort + ServiceLoader registration; the
            -deployment artifact ships the @BuildStep methods that
            Quarkus discovers at build time.
        -->
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-core-impl</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-cdi-module-api</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-quarkus-module-runtime</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>${project.groupId}</groupId>
            <artifactId>jawelte-quarkus-module-deployment</artifactId>
            <scope>test</scope>
        </dependency>

        <!--
            Quarkus brings its own jakarta APIs transitively through
            quarkus-arc. quarkus-junit5 wires @QuarkusTest into JUnit.
        -->
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-arc</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>io.quarkus</groupId>
            <artifactId>quarkus-junit</artifactId>
            <scope>test</scope>
            <exclusions>
                <!--
                    Quarkus 3.x is jakarta-native; the javax.* artifacts
                    that quarkus-junit transitively drags through Maven
                    Resolver (Plexus DI inside Maven 3.9) are legacy
                    baggage that conflicts with the project's
                    BannedDependencies rule. Pruned here; if Maven
                    Resolver actually needs them at runtime, the
                    failure will surface at test time and we'll
                    re-evaluate.
                -->
                <exclusion>
                    <groupId>javax.inject</groupId>
                    <artifactId>javax.inject</artifactId>
                </exclusion>
                <exclusion>
                    <groupId>javax.annotation</groupId>
                    <artifactId>javax.annotation-api</artifactId>
                </exclusion>
            </exclusions>
        </dependency>

        <dependency>
            <groupId>org.eclipse.microprofile.config</groupId>
            <artifactId>microprofile-config-api</artifactId>
            <scope>test</scope>
        </dependency>

        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
        </dependency>

        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
        </dependency>

        <dependency>
            <groupId>org.assertj</groupId>
            <artifactId>assertj-core</artifactId>
        </dependency>
    </dependencies>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    quarkus-maven-plugin builds the Quarkus app's
                    augmentation that @QuarkusTest needs to bootstrap
                    ArC at test time. Configured here so per-scenario
                    poms inherit the wiring without repeating it.
                -->
                <plugin>
                    <groupId>io.quarkus</groupId>
                    <artifactId>quarkus-maven-plugin</artifactId>
                    <version>${quarkus.version}</version>
                    <extensions>true</extensions>
                    <executions>
                        <execution>
                            <goals>
                                <goal>build</goal>
                                <goal>generate-code</goal>
                                <goal>generate-code-tests</goal>
                            </goals>
                        </execution>
                    </executions>
                </plugin>
            </plugins>
        </pluginManagement>
        <plugins>
            <plugin>
                <groupId>io.quarkus</groupId>
                <artifactId>quarkus-maven-plugin</artifactId>
            </plugin>
        </plugins>
    </build>
</project>
