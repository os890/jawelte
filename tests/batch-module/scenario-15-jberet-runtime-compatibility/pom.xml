<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>org.os890.jawelte</groupId>
        <artifactId>jawelte-tests-batch-module</artifactId>
        <version>0.2.0-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>
    <artifactId>jawelte-tests-batch-module-scenario-15-jberet-runtime-compatibility</artifactId>
    <packaging>jar</packaging>
    <name>jawelte tests/batch-module scenario 15: JBeret on the test classpath instead of BatchEE — BatchRuntime.getJobOperator() picks up JBeret's DelegatingJobOperator via ServiceLoader; the observer drives a JSL job to BatchStatus.COMPLETED with no code changes — exercises cross-runtime compatibility</name>

    <dependencies>
        <!--
            jberet-core ships the DelegatingJobOperator (registered
            via META-INF/services/jakarta.batch.operations.JobOperator),
            the JBeret CDI portable extension, the InMemoryRepository,
            and the MetaInfBatchJobsJobXmlResolver. It is the JBeret
            equivalent of batchee-jbatch as far as the
            BatchRuntime.getJobOperator() ServiceLoader handshake is
            concerned.

            jberet-se is deliberately NOT pulled in here: its
            BatchSEEnvironment / SEArtifactFactory hard-wire Weld
            and would either fight the active CDI runtime (OWB
            under -Powb) or duplicate it (Weld under -Pweld). This
            scenario provides its own runtime-agnostic
            BatchEnvironment + ArtifactFactory instead — see the
            test-only TestBatchEnvironment / TestArtifactFactory
            classes registered via META-INF/services.
        -->
        <dependency>
            <groupId>org.jberet</groupId>
            <artifactId>jberet-core</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            jakarta.transaction-api is declared at provided scope in
            our depMgmt (and in JBeret's parent pom); promote it to
            test scope here so JBeret's static initialisers can
            resolve InvalidTransactionException without dragging JTA
            into the rest of the batch-module test matrix.
        -->
        <dependency>
            <groupId>jakarta.transaction</groupId>
            <artifactId>jakarta.transaction-api</artifactId>
            <scope>test</scope>
        </dependency>
        <!--
            JBeret's JobOperatorImpl references
            org.wildfly.security.manager.WildFlySecurityManager at
            class init but does not declare the dep in its own
            packaging (WildFly provides it as part of the platform).
            The SE test classpath has to supply it explicitly.
        -->
        <dependency>
            <groupId>org.wildfly.core</groupId>
            <artifactId>wildfly-security-manager</artifactId>
            <version>18.1.2.Final</version>
            <scope>test</scope>
        </dependency>
    </dependencies>
</project>
